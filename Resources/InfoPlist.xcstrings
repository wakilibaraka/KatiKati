    "NSAppleEventsUsageDescription" : {
      "comment" : "系统自动化授权用途：访达内容预览、废纸篓状态与清倒。",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "KatiKati uses this to preview the folder shown in Finder, display whether the Trash is empty, and empty the Trash."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "用于读取当前访达窗口所在文件夹以显示快捷面板，以及显示废纸篓空满状态和清倒废纸篓。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "KatiKati會使用這項權限來預覽Finder顯示的檔案夾、顯示垃圾桶是否為空，以及清空垃圾桶。"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "KatiKatiは、Finderで表示しているフォルダの内容をプレビューし、ゴミ箱が空かどうかを表示し、ゴミ箱を空にするためにこれを使用します。"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "KatiKati verwendet dies, um den im Finder angezeigten Ordner in der Vorschau zu zeigen, anzuzeigen, ob der Papierkorb leer ist, und den Papierkorb zu entleeren."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "KatiKati utilise cette autorisation pour prévisualiser le dossier affiché dans le Finder, indiquer si la corbeille est vide et vider la corbeille."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "KatiKati usa este permiso para previsualizar la carpeta abierta en el Finder, mostrar si la papelera está vacía y vaciarla."
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "KatiKati usa este permiso para mostrar una vista previa de la carpeta abierta en el Finder, indicar si el basurero está vacío y vaciarlo."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O KatiKati usa isto para pré-visualizar a pasta exibida no Finder, mostrar se o Lixo está vazio e esvaziar o Lixo."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O KatiKati utiliza isto para pré-visualizar a pasta apresentada no Finder, indicar se o Lixo está vazio e esvaziar o Lixo."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "KatiKati usa questa autorizzazione per mostrare l’anteprima della cartella visualizzata nel Finder, indicare se il Cestino è vuoto e svuotarlo."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "KatiKati는 Finder에 표시된 폴더를 미리 보고, 휴지통이 비어 있는지 표시하고, 휴지통을 비우는 데 이 권한을 사용합니다."
          }
        }
      }
    },
    "NSMicrophoneUsageDescription" : {
      "comment" : "widget 面板录音机的麦克风权限：录制期间才会开启麦克风。",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Records the takes you start in the widget pane recorder. The microphone is on only while a take is running."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "录制你在 widget 面板录音机中开始的片段。麦克风仅在片段录制期间开启。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "錄製你在 widget 面板錄音機中開始的片段。麥克風僅在片段錄製期間開啟。"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ウィジェットパネルのレコーダーで開始するテイクを録音します。マイクはテイクの実行中のみオンになります。"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nimmt die Takes auf, die Sie im Recorder des Widget-Bereichs starten. Das Mikrofon ist nur während eines Takes eingeschaltet."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Enregistre les prises que vous démarrez dans l’enregistreur du panneau de widgets. Le micro n’est actif que pendant une prise."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Graba las tomas que inicias en el grabador del panel de widgets. El micrófono solo está activo mientras se graba una toma."
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Graba las tomas que inicias en el grabador del panel de widgets. El micrófono solo está activo mientras se graba una toma."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Grava as takes que você inicia no gravador do painel de widgets. O microfone fica ligado apenas durante uma take."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Grava as gravações que inicia no gravador do painel de widgets. O microfone está ativo apenas durante uma gravação."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Registra le riprese che avvii nel registratore del pannello widget. Il microfono è attivo solo durante una ripresa."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "위젯 패널의 레코더에서 시작하는 테이크를 녹음합니다. 마이크는 테이크가 진행되는 동안에만 켜집니다。"
          }
        }
      }
    }
  },
  "version" : "1.0"
}
