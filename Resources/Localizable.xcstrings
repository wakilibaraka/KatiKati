    "Pick a shortcut from the list, or press Record and type a key combination with ⌃, ⌥, ⇧ or ⌘.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Pick a shortcut from the list, or press Record and type a key combination with ⌃, ⌥, ⇧ or ⌘."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "从列表中选择快捷键，或点按“录制”后输入含 ⌃、⌥、⇧ 或 ⌘ 的组合键。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "從列表中選擇快速鍵，或按「錄製」後輸入含 ⌃、⌥、⇧ 或 ⌘ 的組合鍵。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "リストからショートカットを選ぶか、「記録」を押して⌃・⌥・⇧・⌘を含むキーの組み合わせを入力します。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wähle ein Kurzbefehl aus der Liste oder drücke „Aufnehmen“ und gib eine Tastenkombination mit ⌃, ⌥, ⇧ oder ⌘ ein."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Choisissez un raccourci dans la liste, ou cliquez sur Enregistrer et saisissez une combinaison avec ⌃, ⌥, ⇧ ou ⌘."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Elige un atajo de la lista, o pulsa Grabar y escribe una combinación con ⌃, ⌥, ⇧ o ⌘."
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "Elige un atajo de la lista, o presiona Grabar y escribe una combinación con ⌃, ⌥, ⇧ o ⌘."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Escolha um atalho da lista ou prima Gravar e escreva uma combinação com ⌃, ⌥, ⇧ ou ⌘."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Escolha um atalho da lista ou prima Gravar e escreva uma combinação com ⌃, ⌥, ⇧ ou ⌘."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Scegli una scorciatoia dall’elenco, oppure premi Registra e digita una combinazione con ⌃, ⌥, ⇧ o ⌘."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "목록에서 단축키를 고르거나 ‘기록’을 누른 뒤 ⌃, ⌥, ⇧, ⌘가 들어간 조합을 입력하세요."
          }
        }
      }
    },
