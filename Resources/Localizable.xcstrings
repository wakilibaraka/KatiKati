    "Uses a private macOS space; hidden automatically when the system does not allow it." : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Uses a private macOS space; hidden automatically when the system does not allow it." } },
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "使用 macOS 私有空间；系统不支持时会自动隐藏。" } },
        "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "使用 macOS 私有空間；系統不支援時會自動隱藏。" } },
        "ja" : { "stringUnit" : { "state" : "translated", "value" : "macOS の非公開スペースを使用します。利用できない場合は自動的に非表示になります。" } },
        "de" : { "stringUnit" : { "state" : "translated", "value" : "Nutzt einen privaten macOS-Bereich; wird automatisch ausgeblendet, wenn das System ihn nicht zulässt." } },
        "fr" : { "stringUnit" : { "state" : "translated", "value" : "Utilise un espace privé de macOS ; masquée automatiquement si le système le refuse." } },
        "es" : { "stringUnit" : { "state" : "translated", "value" : "Usa un espacio privado de macOS; se oculta automáticamente si el sistema no lo permite." } },
        "es-419" : { "stringUnit" : { "state" : "translated", "value" : "Usa un espacio privado de macOS; se oculta automáticamente si el sistema no lo permite." } },
        "pt-BR" : { "stringUnit" : { "state" : "translated", "value" : "Usa um espaço privado do macOS; fica oculto automaticamente quando o sistema não permite." } },
        "pt-PT" : { "stringUnit" : { "state" : "translated", "value" : "Usa um espaço privado do macOS; fica oculto automaticamente quando o sistema não o permite." } },
        "it" : { "stringUnit" : { "state" : "translated", "value" : "Usa uno spazio privato di macOS; si nasconde automaticamente se il sistema non lo consente." } },
        "ko" : { "stringUnit" : { "state" : "translated", "value" : "macOS 비공개 공간을 사용합니다. 시스템이 허용하지 않으면 자동으로 숨겨집니다." } }
      }
    },
    "Animated Album Art" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Animated Album Art" } },
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "动态专辑封面" } },
        "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "動態專輯封面" } },
        "ja" : { "stringUnit" : { "state" : "translated", "value" : "アニメーションアルバムアート" } },
        "de" : { "stringUnit" : { "state" : "translated", "value" : "Animiertes Albumcover" } },
        "fr" : { "stringUnit" : { "state" : "translated", "value" : "Pochette animée" } },
        "es" : { "stringUnit" : { "state" : "translated", "value" : "Portada animada" } },
        "es-419" : { "stringUnit" : { "state" : "translated", "value" : "Portada animada" } },
        "pt-BR" : { "stringUnit" : { "state" : "translated", "value" : "Capa animada" } },
        "pt-PT" : { "stringUnit" : { "state" : "translated", "value" : "Capa animada" } },
        "it" : { "stringUnit" : { "state" : "translated", "value" : "Copertina animata" } },
        "ko" : { "stringUnit" : { "state" : "translated", "value" : "애니메이션 앨범 아트" } }
      }
    },
    "Slides and zooms the art on a slow loop. Frames are pre-rendered once per track, so playback stays cheap and pausing stops all of it." : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Slides and zooms the art on a slow loop. Frames are pre-rendered once per track, so playback stays cheap and pausing stops all of it." } },
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "封面会缓慢循环平移和缩放。每首歌只预渲染一次画面，播放开销很低，暂停时会完全停止。" } },
        "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "封面會緩慢循環平移和縮放。每首歌只預先算圖一次，播放開銷很低，暫停時會完全停止。" } },
        "ja" : { "stringUnit" : { "state" : "translated", "value" : "アートがゆっくりループして動きます。フレームは曲ごとに一度だけ生成されるので再生は軽く、一時停止で完全に止まります。" } },
        "de" : { "stringUnit" : { "state" : "translated", "value" : "Das Cover wandert und zoomt langsam in einer Schleife. Die Bilder werden pro Titel einmal vorgerendert — Wiedergabe bleibt günstig, Pause stoppt alles." } },
        "fr" : { "stringUnit" : { "state" : "translated", "value" : "La pochette glisse et zoome en boucle lente. Les images sont pré-rendues une fois par morceau : la lecture reste légère et la pause arrête tout." } },
        "es" : { "stringUnit" : { "state" : "translated", "value" : "La portada se desplaza y amplía en un bucle lento. Los fotogramas se generan una vez por pista, así que la reproducción es ligera y la pausa lo detiene todo." } },
        "es-419" : { "stringUnit" : { "state" : "translated", "value" : "La portada se desplaza y amplía en un bucle lento. Los fotogramas se generan una vez por pista, así que la reproducción es ligera y la pausa lo detiene todo." } },
        "pt-BR" : { "stringUnit" : { "state" : "translated", "value" : "A capa desliza e amplia num ciclo lento. Os quadros são gerados uma vez por faixa, pelo que a reprodução é leve e a pausa para tudo." } },
        "pt-PT" : { "stringUnit" : { "state" : "translated", "value" : "A capa desliza e amplia num ciclo lento. As imagens são geradas uma vez por faixa, pelo que a reprodução é leve e a pausa para tudo." } },
        "it" : { "stringUnit" : { "state" : "translated", "value" : "La copertina scorre e zooma in un ciclo lento. I fotogrammi sono generati una volta per brano: la riproduzione resta leggera e la pausa ferma tutto." } },
        "ko" : { "stringUnit" : { "state" : "translated", "value" : "앨범 아트가 천천히 반복되며 이동하고 확대됩니다. 프레임은 트랙당 한 번만 미리 렌더링되어 재생 부담이 적고, 일시 정지하면 모두 멈춥니다." } }
      }
    },
