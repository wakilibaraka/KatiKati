    "Look 20 feet away for 20 seconds." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Schau 20 Sekunden lang etwa 6 Meter weit."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mira a unos 6 metros durante 20 segundos."
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mira a unos 6 metros durante 20 segundos."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Regardez à environ 6 mètres pendant 20 secondes."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Guarda a circa 6 metri per 20 secondi."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "6メートル先を20秒間見つめましょう。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "6미터 떨어진 곳을 20초 동안 바라보세요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kijk 20 seconden lang ongeveer 6 meter voor je uit."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Olhe para cerca de 6 metros de distância por 20 segundos."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Olhe para cerca de 6 metros de distância durante 20 segundos."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Смотрите на расстояние около 6 метров 20 секунд."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "望向约 6 米外，停留 20 秒。"
