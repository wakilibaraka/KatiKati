    "A music surface at the desktop layer. It never covers an app window and it never changes your wallpaper." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Eine Musikfläche auf der Schreibtisch-Ebene. Sie verdeckt nie ein App-Fenster und ändert nie dein Schreibtischbild."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A music surface at the desktop layer. It never covers an app window and it never changes your wallpaper."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Una superficie musical en la capa del escritorio. Nunca cubre la ventana de una app ni cambia tu fondo de pantalla."
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Una superficie musical en la capa del escritorio. Nunca cubre la ventana de una app ni cambia tu fondo de pantalla."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Une surface musicale au niveau du bureau. Elle ne recouvre jamais une fenêtre d’app et ne modifie jamais votre fond d’écran."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Una superficie musicale al livello della scrivania. Non copre mai la finestra di un’app e non cambia mai lo sfondo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "デスクトップ階層に置かれる音楽サーフェス。App ウインドウを覆うことも、壁紙を変えることもありません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "데스크탑 레이어에 놓이는 음악 서피스입니다. 앱 윈도우를 가리지 않으며 배경화면도 바꾸지 않습니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uma superfície musical na camada da área de trabalho. Ela nunca cobre a janela de um app nem altera seu papel de parede."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uma superfície musical na camada da área de trabalho. Nunca cobre a janela de uma app nem altera o seu papel de parede."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "位于桌面层的音乐表面。它绝不会遮挡 App 窗口，也不会改变你的壁纸。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "位於桌面層的音樂介面。它絕不會遮住 App 視窗，也不會改變你的桌布。"
          }
        }
      }
    },
