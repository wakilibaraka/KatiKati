    "Full-screen art behind your icons. Click-through, so icons, right-click and drag-select all keep working." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vollbild-Artwork hinter deinen Symbolen. Klicks gehen hindurch, daher funktionieren Symbole, Rechtsklick und Auswahl per Ziehen weiterhin."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Full-screen art behind your icons. Click-through, so icons, right-click and drag-select all keep working."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Portada a pantalla completa tras los iconos. Deja pasar los clics, así que iconos, clic derecho y selección por arrastre siguen funcionando."
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Portada a pantalla completa tras los iconos. Deja pasar los clics, así que iconos, clic derecho y selección por arrastre siguen funcionando."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pochette plein écran derrière vos icônes. Les clics la traversent : icônes, clic droit et sélection par glisser fonctionnent toujours."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Copertina a tutto schermo dietro le icone. I clic passano oltre: icone, clic destro e selezione a trascinamento continuano a funzionare."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "アイコンの後ろに全画面アート。クリックは透過するので、アイコン、右クリック、範囲選択はそのまま使えます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "아이콘 뒤의 전체 화면 아트. 클릭이 통과되므로 아이콘, 오른쪽 클릭, 드래그 선택이 모두 그대로 작동합니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Arte em tela cheia atrás dos ícones. Os cliques atravessam, então ícones, clique com o botão direito e seleção por arrasto continuam funcionando."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Arte em ecrã inteiro atrás dos ícones. Os cliques atravessam, pelo que ícones, clique com o botão direito e seleção por arrasto continuam a funcionar."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "图标背后的全屏封面。支持点击穿透，图标、右键操作和拖拽框选都照常可用。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "圖示背後的全螢幕封面。支援點擊穿透，圖示、右鍵操作和拖曳框選都照常可用。"
          }
        }
      }
    },
    "Half the screen: art, title, scrubber and transport. Above the icons, below every app window." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
