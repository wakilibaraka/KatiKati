    "Protect ⌘Q with a hold or double-tap so accidental presses never quit an app. Apps listed below can skip or keep their own ⌘Q." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "⌘Q mit Halten oder Doppeltippen absichern, damit versehentliches Drücken keine App beendet. Aufgeführte Apps können ihr eigenes ⌘Q überspringen oder behalten."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Protect ⌘Q with a hold or double-tap so accidental presses never quit an app. Apps listed below can skip or keep their own ⌘Q."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Protege ⌘Q con una pulsación larga o doble toque para que una pulsación accidental no cierre una app. Las apps de abajo pueden omitir o conservar su propio ⌘Q."
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Protege ⌘Q con una pulsación larga o doble toque para que un pulsado accidental no cierre una app. Las apps de abajo pueden omitir o conservar su propio ⌘Q."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Protégez ⌘Q par un maintien ou un double appui pour éviter de quitter une app par erreur. Les apps ci-dessous peuvent ignorer ou garder leur propre ⌘Q."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Proteggi ⌘Q con una pressione prolungata o un doppio tocco così che una pressione accidentale non chiuda un'app. Le app sotto possono saltare o mantenere il proprio ⌘Q."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "長押しまたはダブルタップで ⌘Q を保護し、誤ってアプリを終了しないようにします。下のアプリは独自の ⌘Q を省略または維持できます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "⌘Q를 길게 누르거나 두 번 탭해 보호하여 실수로 앱이 종료되지 않게 합니다. 아래 앱은 자체 ⌘Q를 건너뛰거나 유지할 수 있습니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Proteja ⌘Q com pressão longa ou toque duplo para que um toque acidental nunca feche um app. Os apps abaixo podem ignorar ou manter o próprio ⌘Q."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Proteja ⌘Q com pressão longa ou toque duplo para que um toque acidental nunca encerre uma app. As apps abaixo podem ignorar ou manter o seu próprio ⌘Q."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "通过按住或双击来保护 ⌘Q，避免误按退出应用。下面列出的应用可以跳过或保留自己的 ⌘Q。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "以按住或連按兩下保護 ⌘Q，避免誤按結束 App。下列 App 可以略過或保留自己的 ⌘Q。"
          }
        }
      }
    },
