    "The keys act on the window under the pointer without leaving the overview. A shortcut is taken only with exactly these modifiers, so the app's own ⌘⇧ shortcuts still work." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Tasten wirken auf das Fenster unter dem Zeiger, ohne die Übersicht zu verlassen. Ein Kürzel greift nur mit genau diesen Modifikatoren, die ⌘⇧-Kürzel der App bleiben also erhalten."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The keys act on the window under the pointer without leaving the overview. A shortcut is taken only with exactly these modifiers, so the app's own ⌘⇧ shortcuts still work."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las teclas actúan sobre la ventana bajo el puntero sin salir de la vista general. Un atajo solo se toma con exactamente estos modificadores, así que los ⌘⇧ de la app siguen funcionando."
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las teclas actúan sobre la ventana bajo el puntero sin salir de la vista general. Un atajo solo se toma con exactamente estos modificadores, así que los ⌘⇧ de la app siguen funcionando."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les touches agissent sur la fenêtre survolée sans quitter la vue d’ensemble. Un raccourci n’est pris qu’avec exactement ces modificateurs : les ⌘⇧ de l’app continuent de fonctionner."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I tasti agiscono sulla finestra sotto il puntatore senza lasciare la panoramica. Una scorciatoia vale solo con esattamente questi modificatori, quindi le ⌘⇧ dell’app continuano a funzionare."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "キーは概要を離れずにポインタ下のウインドウに作用します。ショートカットはこの修飾キーが完全に一致するときだけ使われるため、アプリ自身の ⌘⇧ はそのまま使えます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "키는 개요를 벗어나지 않고 포인터 아래 윈도우에 작용합니다. 단축키는 이 보조 키가 정확히 일치할 때만 사용되므로 앱 자체의 ⌘⇧ 단축키는 그대로 작동합니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "As teclas agem na janela sob o ponteiro sem sair da visão geral. Um atalho só é usado com exatamente esses modificadores, então os ⌘⇧ do app continuam funcionando."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "As teclas atuam na janela sob o ponteiro sem sair da vista geral. Um atalho só é usado com exatamente estes modificadores, pelo que os ⌘⇧ da app continuam a funcionar."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "按键作用于指针下的窗口，无需离开概览。只有修饰键完全一致时才会使用快捷键，因此应用自身的 ⌘⇧ 快捷键仍然有效。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "按鍵作用於指標下的視窗，無需離開概覽。只有修飾鍵完全一致時才會使用快速鍵，因此應用程式自身的 ⌘⇧ 快速鍵仍然有效。"
          }
        }
      }
    },
