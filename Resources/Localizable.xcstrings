        "es-419" : { "stringUnit" : { "state" : "translated", "value" : "Respira un momento." } },
        "fr" : { "stringUnit" : { "state" : "translated", "value" : "Respirez un instant." } },
        "it" : { "stringUnit" : { "state" : "translated", "value" : "Fai un respiro." } },
