    "Shows live window thumbnails in hover previews. Without it, previews show titles only.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Shows live window thumbnails in hover previews. Without it, previews show titles only."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在悬停预览中显示窗口实时缩略图；没有此权限时只显示标题。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在懸停預覽中顯示視窗即時縮圖；沒有此權限時只顯示標題。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ホバープレビューにウインドウのライブサムネイルを表示します。許可がない場合はタイトルのみ表示されます。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zeigt Live-Fenstervorschauen in den Hover-Vorschauen. Ohne sie werden nur Titel angezeigt."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Affiche des miniatures de fenêtres en direct dans les aperçus au survol. Sans elle, seuls les titres s’affichent."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Muestra miniaturas de ventanas en vivo en las vistas previas. Sin ella, solo se muestran los títulos."
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "Muestra miniaturas de ventanas en vivo en las vistas previas. Sin ella, solo se muestran los títulos."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Mostra miniaturas de janelas em tempo real nas pré-visualizações. Sem ela, só aparecem os títulos."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Mostra miniaturas de janelas em tempo real nas pré-visualizações. Sem ela, só aparecem os títulos."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Mostra miniature live delle finestre nelle anteprime. Senza, vengono mostrati solo i titoli."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "호버 미리보기에 창의 실시간 썸네일을 표시합니다. 권한이 없으면 제목만 표시됩니다."
          }
        }
      }
    },
