    "Slim bars on the screen edges for notes, productivity and system status. Pick a layout, flip it to either side, or choose Custom to place each item yourself.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Slim bars on the screen edges for notes, productivity and system status. Pick a layout, flip it to either side, or choose Custom to place each item yourself."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "屏幕边缘的细长栏，用于备忘录、效率工具和系统状态。选择一种布局，将其换到任一侧，或选“自定义”自行摆放每一项。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "螢幕邊緣的細長列，用於備忘錄、效率工具與系統狀態。選擇一種版面、將其換到任一側，或選「自訂」自行擺放每個項目。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "画面の端に表示する細いバーで、メモ、生産性ツール、システム状況を表示します。レイアウトを選び、左右どちらかに切り替えるか、「カスタム」で各項目を自由に配置できます。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Schmale Leisten an den Bildschirmrändern für Notizen, Produktivität und Systemstatus. Wähle ein Layout, wechsle die Seite oder nutze „Benutzerdefiniert“, um jedes Element selbst zu platzieren."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Barres fines sur les bords de l’écran pour les notes, la productivité et l’état du système. Choisissez une disposition, passez-la de l’autre côté ou choisissez Personnalisé pour placer chaque élément vous-même."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Barras finas en los bordes de la pantalla para notas, productividad y estado del sistema. Elige un diseño, cámbialo de lado o elige Personalizado para colocar cada elemento tú mismo."
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "Barras delgadas en los bordes de la pantalla para notas, productividad y estado del sistema. Elige un diseño, cámbialo de lado o elige Personalizado para colocar cada elemento tú mismo."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Barras finas nas bordas da tela para notas, produtividade e status do sistema. Escolha um layout, mude de lado ou escolha Personalizado para posicionar cada item você mesmo."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Barras finas nas margens do ecrã para notas, produtividade e estado do sistema. Escolha uma disposição, mude de lado ou escolha Personalizado para posicionar cada item."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Barre sottili ai bordi dello schermo per note, produttività e stato del sistema. Scegli un layout, spostalo su un altro lato o scegli Personalizzato per posizionare ogni elemento da solo."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "화면 가장자리의 얇은 막대로 메모, 생산성 도구, 시스템 상태를 표시합니다. 레이아웃을 고르고 좌우를 바꾸거나 ‘사용자 지정’으로 각 항목을 직접 배치하세요."
          }
        }
      }
    },
