    "Rows: windows stack top to bottom, full width.": {
      "extractionState": "manual",
      "localizations": {
        "en": {"stringUnit": {"state": "translated", "value": "Rows: windows stack top to bottom, full width."}},
        "zh-Hans": {"stringUnit": {"state": "translated", "value": "行：窗口自上而下堆叠，占满宽度。"}},
        "zh-Hant": {"stringUnit": {"state": "translated", "value": "列：視窗由上而下堆疊，佔滿寬度。"}},
        "ja": {"stringUnit": {"state": "translated", "value": "行：ウィンドウを全幅で上下に積み重ねます。"}},
        "de": {"stringUnit": {"state": "translated", "value": "Zeilen: Fenster stapeln sich von oben nach unten, volle Breite."}},
        "fr": {"stringUnit": {"state": "translated", "value": "Lignes : les fenêtres s’empilent de haut en bas, sur toute la largeur."}},
        "es": {"stringUnit": {"state": "translated", "value": "Filas: las ventanas se apilan de arriba abajo, a todo el ancho."}},
        "es-419": {"stringUnit": {"state": "translated", "value": "Filas: las ventanas se apilan de arriba abajo, a todo el ancho."}},
        "pt-BR": {"stringUnit": {"state": "translated", "value": "Linhas: as janelas empilham-se de cima para baixo, em toda a largura."}},
        "pt-PT": {"stringUnit": {"state": "translated", "value": "Linhas: as janelas empilham-se de cima para baixo, em toda a largura."}},
        "it": {"stringUnit": {"state": "translated", "value": "Righe: le finestre si impilano dall’alto in basso, a tutta larghezza."}},
        "ko": {"stringUnit": {"state": "translated", "value": "행: 창을 전체 폭으로 위에서 아래로 쌓습니다."}}
