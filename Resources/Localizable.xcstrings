    "Turn on KatiKati in %@. This window closes by itself once you do, and the taskbar finishes starting.": {
      "comment": "%@ 是系统设置里的权限路径，随 macOS 版本不同",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请在%@中，打开 KatiKati的开关。开启后本窗口会自动关闭，Dock 栏会继续启动。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Turn on KatiKati in %@. This window closes by itself once you do, and the taskbar finishes starting."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "請在%@中打開KatiKati的開關。打開後這個視窗會自動關閉，工作列也會繼續啟動。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@でKatiKatiをオンにしてください。オンにするとこのウインドウは自動的に閉じ、タスクバーの起動が完了します。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Aktiviere KatiKati unter %@. Sobald du das getan hast, schließt sich dieses Fenster von selbst und die Taskleiste startet vollständig."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Activez KatiKati dans %@. Cette fenêtre se ferme alors d’elle-même et la barre des tâches termine son démarrage."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Activa KatiKati en %@. Esta ventana se cerrará sola cuando lo hagas y la barra de tareas terminará de iniciarse."
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "Activa KatiKati en %@. Esta ventana se cerrará automáticamente cuando lo hagas y la barra de tareas terminará de iniciarse."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Ative o KatiKati em %@. Esta janela se fecha sozinha quando você fizer isso, e a barra de tarefas termina de iniciar."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Ative o KatiKati em %@. Esta janela fecha-se sozinha assim que o fizer e a barra de tarefas conclui o arranque."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Attiva KatiKati in %@. Questa finestra si chiude da sola quando lo fai e la barra delle applicazioni completa l’avvio."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@에서 KatiKati를 켜십시오. 켜면 이 윈도우가 자동으로 닫히고 작업 표시줄이 시작됩니다."
          }
        }
      }
    },
    "Use at least one of Command, Control or Option.": {
      "comment": "设置窗口 · 改键被拒弹窗",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "至少要包含 ⌘、⌃ 或 ⌥ 中的一个。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Use at least one of Command, Control or Option."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "至少要包含Command、Control或Option其中一個。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Command、Control、Optionのいずれかを1つ以上含めてください。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Verwende mindestens eine der Tasten Command, Control oder Option."
          }
        },
        "fr": {
          "stringUnit": {
