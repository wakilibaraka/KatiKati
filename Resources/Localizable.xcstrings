    "0% keeps the plate solid OLED black; 85% lets the desktop frost through." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "0 % lässt die Platte sattes OLED-Schwarz, bei 85 % schimmert der Schreibtisch durch das Milchglas."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "0% keeps the plate solid OLED black; 85% lets the desktop frost through."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Con 0 % la placa queda en negro OLED sólido; con 85 % el escritorio se filtra tras el cristal esmerilado."
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Con 0 % la placa queda en negro OLED sólido; con 85 % el escritorio se filtra tras el cristal esmerilado."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "À 0 %, la plaque reste d’un noir OLED opaque ; à 85 %, le bureau transparaît derrière le verre dépoli."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Allo 0% la piastra resta nero OLED pieno; all’85% il desktop filtra attraverso il vetro smerigliato."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "0% ではノッチは OLED ブラックのまま、85% ではデスクトップがすりガラス越しに透けます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "0%에서는 노치가 단색 OLED 블랙으로 유지되고, 85%에서는 데스크톱이 흐린 유리 너머로 비칩니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Com 0% a placa fica em preto OLED sólido; com 85% a mesa aparece através do vidro fosco."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A 0% a placa fica em preto OLED sólido; a 85% o ambiente aparece através do vidro fosco."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "0% 时刘海保持纯色 OLED 黑；85% 时桌面会透过磨砂玻璃渗入。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "0% 時瀏海保持純色 OLED 黑；85% 時桌面會透過霧面玻璃滲入。"
          }
        }
      }
    },
