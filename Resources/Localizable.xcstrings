    "Rest the pointer on the left edge of a display for a moment to open the drawer. ⌃⌥W always works." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Halte den Zeiger kurz an den linken Rand eines Displays, um den Bereich zu öffnen. ⌃⌥W funktioniert immer."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rest the pointer on the left edge of a display for a moment to open the drawer. ⌃⌥W always works."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deja el puntero un momento en el borde izquierdo de una pantalla para abrir el cajón. ⌃⌥W siempre funciona."
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deja el puntero un momento en el borde izquierdo de una pantalla para abrir el cajón. ⌃⌥W siempre funciona."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Laissez un instant le pointeur sur le bord gauche d’un écran pour ouvrir le tiroir. ⌃⌥W fonctionne toujours."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sosta per un momento con il puntatore sul bordo sinistro di uno schermo per aprire il pannello. ⌃⌥W funziona sempre."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ディスプレイの左端にポインタをしばらく置くとドロワーが開きます。⌃⌥W はいつでも使えます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "디스플레이 왼쪽 가장자리에 포인터를 잠시 두면 서랍이 열립니다. ⌃⌥W는 항상 사용할 수 있습니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mantenha o ponteiro por um instante na borda esquerda de uma tela para abrir o painel. ⌃⌥W sempre funciona."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deixe o ponteiro por instantes na margem esquerda de um ecrã para abrir o painel. ⌃⌥W funciona sempre."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "将指针在显示器左侧边缘停留片刻即可打开抽屉。⌃⌥W 始终可用。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "將指標在顯示器左側邊緣停留片刻即可開啟抽屜。⌃⌥W 一直可用。"
          }
        }
      }
