    "Pinned items never expire. History is kept in memory only.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Pinned items never expire. History is kept in memory only."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "置顶项目永不过期。历史仅保存在内存中。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "釘選項目永不過期。歷史僅保存在記憶體中。"
