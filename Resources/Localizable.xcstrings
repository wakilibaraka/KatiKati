    "These permissions help KatiKati work properly. You can change them any time in System Settings › Privacy & Security.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "These permissions help KatiKati work properly. You can change them any time in System Settings › Privacy & Security."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这些权限能让 KatiKati 正常工作。你可以随时在“系统设置 › 隐私与安全性”中更改。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "這些權限能讓 KatiKati 正常運作。你可以隨時在「系統設定 › 隱私權與安全性」中更改。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "これらの許可はKatiKatiが正しく動作するために役立ちます。システム設定 › プライバシーとセキュリティでいつでも変更できます。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diese Berechtigungen helfen KatiKati, richtig zu funktionieren. Du kannst sie jederzeit in den Systemeinstellungen › Datenschutz & Sicherheit ändern."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ces autorisations aident KatiKati à fonctionner correctement. Vous pouvez les modifier à tout moment dans Réglages Système › Confidentialité et sécurité."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Estos permisos ayudan a que KatiKati funcione correctamente. Puedes cambiarlos en cualquier momento en Ajustes del Sistema › Privacidad y seguridad."
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "Estos permisos ayudan a que KatiKati funcione correctamente. Puedes cambiarlos en cualquier momento en Configuración del Sistema › Privacidad y seguridad."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Estas permissões ajudam o KatiKati a funcionar corretamente. Você pode alterá-las a qualquer momento em Ajustes do Sistema › Privacidade e Segurança."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Estas permissões ajudam o KatiKati a funcionar corretamente. Pode alterá-las a qualquer momento em Definições do Sistema › Privacidade e Segurança."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Queste autorizzazioni aiutano KatiKati a funzionare correttamente. Puoi modificarle in qualsiasi momento in Impostazioni di Sistema › Privacy e sicurezza."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 권한은 KatiKati가 제대로 작동하는 데 도움이 됩니다. 시스템 설정 › 개인정보 보호 및 보안에서 언제든 변경할 수 있습니다."
          }
        }
      }
    },
