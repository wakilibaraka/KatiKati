    "Floating overlay showing all menu shortcuts for the active app plus your KatiKati shortcuts. Release ⌘ to dismiss, or pin it open." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Schwebendes Overlay mit allen Menü-Kurzbefehlen der aktiven App und deinen KatiKati-Kurzbefehlen. ⌘ loslassen zum Schließen oder anheften."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Floating overlay showing all menu shortcuts for the active app plus your KatiKati shortcuts. Release ⌘ to dismiss, or pin it open."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Superposición flotante con todos los atajos de menú de la app activa y tus atajos de KatiKati. Suelta ⌘ para cerrarla o fíjala."
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Superposición flotante con todos los atajos de menú de la app activa y tus atajos de KatiKati. Suelta ⌘ para cerrarla o fíjala."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Superposition flottante affichant tous les raccourcis de menu de l'app active et vos raccourcis KatiKati. Relâchez ⌘ pour fermer ou épinglez-la."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sovrapposizione flottante con tutte le scorciatoie di menu dell'app attiva e le tue scorciatoie KatiKati. Rilascia ⌘ per chiudere o fissala."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "最前面のアプリのメニューショートカットと KatiKati のショートカットを表示する浮動オーバーレイ。⌘ を離すと閉じ、固定すると開いたままになります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "활성 앱의 모든 메뉴 단축키와 KatiKati 단축키를 보여 주는 떠 있는 오버레이입니다. ⌘을 놓으면 닫히고, 고정하면 계속 열려 있습니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sobreposição flutuante com todos os atalhos de menu do app ativo e seus atalhos do KatiKati. Solte ⌘ para fechar ou fixe-a aberta."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sobreposição flutuante com todos os atalhos de menu da app ativa e os teus atalhos do KatiKati. Larga ⌘ para fechar ou fixa-a aberta."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "浮动浮层，显示当前应用的所有菜单快捷键以及你的 KatiKati 快捷键。松开 ⌘ 关闭，或固定保持打开。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "浮動浮層，顯示目前 App 的所有選單快速鍵以及你的 KatiKati 快速鍵。放開 ⌘ 關閉，或固定保持開啟。"
          }
        }
      }
