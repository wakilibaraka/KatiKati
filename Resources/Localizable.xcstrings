    "Dock floats above normal application windows at all times.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Dock floats above normal application windows at all times."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "坞站始终悬浮于常规应用窗口之上。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "塢站始終懸浮於常規應用視窗之上。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ドックは常に標準アプリケーションウィンドウの前面に表示されます。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Dock schwebt immer über normalen Anwendungsfenstern."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le Dock flotte toujours au-dessus des fenêtres d'application normales."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El Dock flota siempre por encima de las ventanas de las aplicaciones normales."
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "El Dock flota siempre por encima de las ventanas de las aplicaciones normales."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O Dock flutua acima das janelas de aplicativos comuns o tempo todo."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "O Dock flutua acima das janelas de aplicações normais o tempo todo."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il Dock fluttua sempre sopra le normali finestre delle applicazioni."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "독이 항상 일반 응용 프로그램 창 위에 떠 있습니다."
          }
        }
      }
    },
    "Floats at native level when clear, drops below windows when overlapped, and peeks on edge hover.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Floats at native level when clear, drops below windows when overlapped, and peeks on edge hover."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无重叠时常驻置顶，窗口覆盖时自动沉底，鼠标贴近底边时临时升起。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "無重疊時常駐置頂，視窗覆蓋時自動置底，滑鼠貼近底邊時臨時升起。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "何もないときは前面、重なり時は背面に回り、画面下端ホバーで手前に浮上します。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Schwebt frei, weicht unter überlappende Fenster aus und erscheint beim Kanten-Hover."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Reste au premier plan si libre, glisse sous les fenêtres couvertes et apparaît au survol du bord."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Flota libremente, se coloca detrás al superponerse y asoma al posar el cursor en el borde."
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "Flota libremente, se coloca detrás al superponerse y asoma al posar el cursor en el borde."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Flutua livremente, fica sob janelas sobrepostas e surge ao passar o cursor pela borda."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Flutua livremente, fica sob janelas sobrepostas e surge ao passar o cursor pela borda."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Fluttua normalmente, scende sotto le finestre sovrapposte e compare sfiorando il bordo."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "창이 없을 땐 위에 뜨고, 겹치면 뒤로 내려가며 가장자리 호버 시 일시적으로 위로 올라옵니다."
          }
        }
      }
    },
    "Renders at normal window level, ordering directly below the frontmost active window.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Renders at normal window level, ordering directly below the frontmost active window."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "位于常规窗口层级，精确置于当前活跃的前台窗口正下方。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "位於常規視窗層級，精確置於當前活躍的前台視窗正下方。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "通常ウィンドウ階層で動作し、最前面のアクティブウィンドウの真後ろに配置されます。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wird auf normaler Fensterebene dargestellt, direkt hinter dem vordersten aktiven Fenster."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "S'affiche au niveau normal des fenêtres, directement sous la fenêtre active au premier plan."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se muestra al nivel normal de ventana, ubicándose justo debajo de la ventana activa principal."
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "Se muestra al nivel normal de ventana, ubicándose justo debajo de la ventana activa principal."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Renderiza no nível normal de janela, posicionando-se logo abaixo da janela ativa em foco."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Apresenta-se no nível normal de janela, posicionando-se logo abaixo da janela ativa em foco."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Rende a livello finestra normale, ordinandosi direttamente sotto la finestra attiva in primo piano."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "일반 윈도우 수준에서 렌더링되며, 맨 앞 활성 창 바로 아래에 배치됩니다."
          }
        }
      }
    },
    "Windows always render on top of the dock; resting the pointer at the bottom edge brings it to the front.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Windows always render on top of the dock; resting the pointer at the bottom edge brings it to the front."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "窗口始终显示在坞站上方；指针在屏幕底边稍作停留即可唤出坞站。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "視窗始終顯示在塢站上方；指標在螢幕底邊稍作停留即可喚出塢站。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ウィンドウが常にドックの前面に表示され、画面下端にポインタを置くとドックが前面化します。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Fenster liegen immer über dem Dock; kurzes Verweilen am unteren Rand holt es nach vorn."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les fenêtres s'affichent toujours sur le Dock ; laissez le curseur au bord inférieur pour l'afficher."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las ventanas siempre cubren el Dock; mantener el puntero en el borde inferior lo trae al frente."
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "Las ventanas siempre cubren el Dock; mantener el puntero en el borde inferior lo trae al frente."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "As janelas sempre cobrem o Dock; pausar o cursor na borda inferior o traz para a frente."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "As janelas cobrem sempre o Dock; manter o ponteiro no limite inferior traz-o para a frente."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le finestre coprono sempre il Dock; fermando il puntatore sul bordo inferiore viene portato avanti."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "창이 항상 독 위에 표시되며, 화면 하단 가장자리에 커서를 잠시 머무르면 독이 나타납니다."
          }
        }
      }
    },
    "Smoothly slides offscreen when an active window enters the dock zone, sliding back on hover.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Smoothly slides offscreen when an active window enters the dock zone, sliding back on hover."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "当活动窗口侵入坞站区域时自动滑出屏幕，光标悬停底边时滑回。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "當活動視窗侵入塢站區域時自動滑出螢幕，游標懸停底邊時滑回。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アクティブウィンドウがドック領域に入るとスムーズに退避し、ホバーで復帰します。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Gleitet sanft aus dem Bild, wenn ein aktives Fenster den Dock-Bereich betritt, und kehrt beim Hovern zurück."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Glisse doucement hors de l'écran lorsqu'une fenêtre active empiète, et revient au survol."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se desliza suavemente fuera de la pantalla cuando entra una ventana activa y regresa al pasar el cursor."
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "Se desliza suavemente fuera de la pantalla cuando entra una ventana activa y regresa al pasar el cursor."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Desliza suavemente para fora da tela quando uma janela ativa invade a área, retornando ao passar o mouse."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Desliza suavemente para fora do ecrã quando uma janela ativa entra na área, regressando ao passar o rato."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Scivola dolcemente fuori schermo quando entra una finestra attiva, tornando visibile al passaggio del mouse."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "활성 창이 독 영역으로 들어오면 화면 밖으로 부드럽게 숨겨지며, 호버 시 다시 슬라이드되어 나타납니다."
          }
        }
      }
    },
    "Becomes click-through and subtle when covered so you can interact with the window underneath.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Becomes click-through and subtle when covered so you can interact with the window underneath."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "被覆盖时变为半透明且点击穿透，确保你可以直接点击被遮挡的窗口底部。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "被覆蓋時變為半透明且點擊穿透，確保你可以直接點擊被遮擋的視窗底部。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "重なり時は半透明かつクリックスルーになり、背後にあるウィンドウの操作を妨げません。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wird bei Überdeckung klick-durchlässig und dezent, damit das darunterliegende Fenster bedienbar bleibt."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Devient transparent et traversable aux clics lorsqu'il est couvert afin d'interagir avec la fenêtre du dessous."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se vuelve translúcido y permite clics directos al cubrirse, facilitando la interacción con la ventana inferior."
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "Se vuelve translúcido y permite clics directos al cubrirse, facilitando la interacción con la ventana inferior."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Torna-se sutil e com clique direto quando coberto para permitir a interação com a janela abaixo."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Torna-se subtil e com clique direto quando coberto para permitir a interação com a janela abaixo."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Diventa discreto e trasparente ai clic quando coperto, permettendo di interagire con la finestra sottostante."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "창에 가려지면 반투명해지고 클릭이 통과되어 가려진 창의 하단을 바로 조작할 수 있습니다."
          }
        }
      }
    },
    "Sits above Apple's Dock to natively reserve window working area with zero permissions.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sits above Apple's Dock to natively reserve window working area with zero permissions."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "叠放于苹果系统 Dock 之上，无需任何权限即可让所有窗口避开坞站区域。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "疊放於蘋果系統 Dock 之上，無需任何權限即可讓所有視窗避開塢站區域。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "システムDockの上に重なることで、権限を一切使わずに画面の作業領域を自然に予約します。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Liegt über Apples Dock, um den Arbeitsbereich für Fenster ganz ohne Berechtigungen freizuhalten."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Se superpose au Dock d'Apple pour réserver l'espace de travail des fenêtres sans aucune autorisation."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se sitúa sobre el Dock de Apple para reservar el área de trabajo de las ventanas sin permisos."
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "Se sitúa sobre el Dock de Apple para reservar el área de trabajo de las ventanas sin permisos."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Sobrepõe-se ao Dock da Apple para reservar nativamente a área de trabalho das janelas sem permissões."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Sobrepõe-se ao Dock da Apple para reservar nativamente a área de trabalho das janelas sem permissões."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Si sovrappone al Dock Apple per riservare l'area di lavoro delle finestre senza alcuna autorizzazione."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple 기본 독 위에 겹쳐져 별도의 권한 없이도 윈도우 작업 영역을 자동으로 확보합니다."
          }
        }
      }
    },
    "Clamps overlapping windows above the dock. Gracefully falls back to dynamic Z-order if permissions are missing.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Clamps overlapping windows above the dock. Gracefully falls back to dynamic Z-order if permissions are missing."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "限制重叠窗口位于坞站上方。若缺少辅助功能权限，将优雅降级为动态层级模式。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "限制重疊視窗位於塢站上方。若缺少輔助功能權限，將平滑降級為動態層級模式。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "重なるウィンドウをドック上端で制限します。権限がない場合は動的Zオーダーに自動で切り替わります。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Begrenzt überlappende Fenster oberhalb des Docks. Fällt bei fehlenden Rechten sanft auf die dynamische Z-Ebene zurück."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Limite les fenêtres chevauchantes au-dessus du Dock. Rétrograde en douceur vers l'ordre Z dynamique sans autorisations."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ajusta las ventanas superpuestas sobre el Dock. Vuelve fluidamente al orden Z dinámico si faltan permisos."
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "Ajusta las ventanas superpuestas sobre el Dock. Vuelve fluidamente al orden Z dinámico si faltan permisos."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Limita janelas sobrepostas acima do Dock. Alterna suavemente para a ordem Z dinâmica se faltarem permissões."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Limita janelas sobrepostas acima do Dock. Alterna suavemente para a ordem Z dinâmica se faltarem permissões."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Blocca le finestre sopra il Dock. Passa automaticamente all'ordine Z dinamico se mancano le autorizzazioni."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "겹치는 창이 독 위로 올라오지 못하게 고정합니다. 권한이 없으면 부드럽게 동적 Z-순서 모드로 대체됩니다."
          }
        }
      }
    },
