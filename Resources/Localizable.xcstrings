    "Blink slowly a few times. Screens make us forget." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Blinzle ein paar Mal langsam. Bildschirme lassen uns das vergessen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Parpadea despacio varias veces. Las pantallas nos lo hacen olvidar."
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Parpadea despacio varias veces. Las pantallas nos lo hacen olvidar."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Clignez lentement des yeux plusieurs fois. Les écrans nous le font oublier."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sbatti le palpebre lentamente un paio di volte. Gli schermi ce lo fanno dimenticare."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ゆっくりまばたきを数回。画面を見ていると忘れがちです。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "천천히 몇 번 눈을 깜빡이세요. 화면을 보면 잊기 쉽습니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Knipper een paar keer langzaam. Schermen laten ons dat vergeten."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pisque devagar algumas vezes. As telas nos fazem esquecer."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pisque devagar algumas vezes. Os ecrãs fazem-nos esquecer."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Медленно моргните несколько раз. Экраны заставляют об этом забыть."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "慢慢眨眼几次。屏幕会让我们忘记这件事。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "慢慢眨眼幾次。螢幕會讓我們忘記這件事。"
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "أغمض عينيك ببطء عدة مرات. الشاشات تجعلنا ننسى."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Blink slowly a few times. Screens make us forget."
          }
        }
      }
    },
    "Find the furthest thing you can see and rest there." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Such den entferntesten Punkt, den du siehst, und ruhe dort aus."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Busca lo más lejano que puedas ver y descansa ahí."
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Busca lo más lejano que puedas ver y descansa ahí."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Trouvez le point le plus lointain que vous voyez et reposez-y votre regard."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Trova la cosa più lontana che riesci a vedere e riposati lì."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "見える中で一番遠いものを見つけて、そこに目を休めましょう。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "볼 수 있는 가장 먼 곳을 찾아 눈을 쉬게 하세요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zoek het verste dat je kunt zien en laat je blik daar rusten."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Encontre a coisa mais distante que consegue ver e descanse ali."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Encontre a coisa mais distante que consegue ver e descanse aí."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Найдите самый дальний предмет в поле зрения и отдохните на нём."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "找到你能看到的最远处，让目光在那里休息。"
          }
        },
        "zh-Hant" : {
