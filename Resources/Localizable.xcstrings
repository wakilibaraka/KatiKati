          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Half the screen: art, title, scrubber and transport. Above the icons, below every app window."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Media pantalla: portada, título, barra de progreso y controles. Sobre los iconos y bajo cualquier ventana de app."
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
