    "Hide the Dock (auto-hide, and don’t wake it at the bottom edge)": {
      "comment": "「不唤醒」是 owner 2026-08-20 定的推荐档位（对应 AppSettingsStore.neverWakeDelay）。",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Hide the Dock (auto-hide, and don’t wake it at the bottom edge)"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "隐藏系统 Dock（自动隐藏，且不在底边唤醒）"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "隱藏Dock（自動隱藏，且不在底邊喚醒）"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Dockを非表示にする（自動的に非表示にし、下端でも呼び出さない）"
          }
        },
        "de": {
