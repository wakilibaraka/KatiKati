    "Keys are off for 60 seconds. Press ⌃⌥⌘P to unlock sooner.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Keys are off for 60 seconds. Press ⌃⌥⌘P to unlock sooner."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "按键将停用 60 秒。按 ⌃⌥⌘P 可提前解锁。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "按鍵將停用 60 秒。按 ⌃⌥⌘P 可提前解鎖。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "キーは60秒間無効になります。⌃⌥⌘P で早く解除できます。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Tasten sind 60 Sekunden aus. Mit ⌃⌥⌘P früher entsperren."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Touches désactivées 60 secondes. ⌃⌥⌘P pour déverrouiller plus tôt."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Teclas desactivadas 60 segundos. Pulsa ⌃⌥⌘P para desbloquear antes."
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "Teclas desactivadas 60 segundos. Presiona ⌃⌥⌘P para desbloquear antes."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Teclas desligadas por 60 segundos. Pressione ⌃⌥⌘P para desbloquear antes."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Teclas desligadas durante 60 segundos. Prima ⌃⌥⌘P para desbloquear antes."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tasti disattivati per 60 secondi. Premi ⌃⌥⌘P per sbloccare prima."
          }
        },
