    "KatiKati just lost its Accessibility permission, so the taskbar has been put away. Turn KatiKati back on in %@.": {
      "comment": "%@ 同上",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "KatiKati刚才失去了辅助功能权限，Dock 栏已经收起。请在%@中重新打开 KatiKati的开关。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "KatiKati just lost its Accessibility permission, so the taskbar has been put away. Turn KatiKati back on in %@."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "KatiKati剛才失去了輔助使用權限，工作列已經收起。請在%@中重新打開KatiKati的開關。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "KatiKatiのアクセシビリティの許可が失われたため、タスクバーを格納しました。%@でKatiKatiをもう一度オンにしてください。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "KatiKati hat gerade seine Bedienungshilfen-Berechtigung verloren, deshalb wurde die Taskleiste eingeklappt. Aktiviere KatiKati unter %@ wieder."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "KatiKati vient de perdre son autorisation d’accessibilité ; la barre des tâches a donc été retirée. Réactivez KatiKati dans %@."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "KatiKati acaba de perder el permiso de accesibilidad, por lo que se ha ocultado la barra de tareas. Vuelve a activar KatiKati en %@."
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "KatiKati acaba de perder el permiso de accesibilidad, por lo que se ocultó la barra de tareas. Vuelve a activar KatiKati en %@."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O KatiKati acabou de perder a permissão de Acessibilidade, então a barra de tarefas foi recolhida. Ative o KatiKati novamente em %@."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "O KatiKati acabou de perder a permissão de Acessibilidade, pelo que a barra de tarefas foi recolhida. Volte a ativar o KatiKati em %@."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "KatiKati ha appena perso l’autorizzazione di accessibilità, quindi la barra delle applicazioni è stata nascosta. Riattiva KatiKati in %@."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "KatiKati가 방금 손쉬운 사용 권한을 잃어 작업 표시줄을 숨겼습니다. %@에서 KatiKati를 다시 켜십시오."
          }
        }
      }
    },
    "KatiKati needs this permission to read and manage your windows.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "KatiKati 需要这项权限来读取和操作窗口。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "KatiKati needs this permission to read and manage your windows."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "KatiKati需要這項權限來讀取與管理你的視窗。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "KatiKatiはウインドウを読み取って操作するために、この許可を必要とします。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "KatiKati benötigt diese Berechtigung, um deine Fenster zu lesen und zu verwalten."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "KatiKati a besoin de cette autorisation pour lire et gérer vos fenêtres."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "KatiKati necesita este permiso para leer y gestionar tus ventanas."
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "KatiKati necesita este permiso para leer y administrar tus ventanas."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O KatiKati precisa desta permissão para ler e gerenciar suas janelas."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "O KatiKati precisa desta permissão para ler e gerir as suas janelas."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "KatiKati richiede questa autorizzazione per leggere e gestire le finestre."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "KatiKati가 윈도우를 읽고 관리하려면 이 권한이 필요합니다."
          }
        }
      }
    },
    "KatiKati will restart itself once you grant it again.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "重新授权后KatiKati会自动重启。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "KatiKati will restart itself once you grant it again."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "重新授權後KatiKati會自行重新啟動。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "もう一度許可すると、KatiKatiは自動的に再起動します。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sobald du sie erneut erteilst, startet sich KatiKati von selbst neu."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "KatiKati redémarrera de lui-même une fois l’autorisation réaccordée."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "KatiKati se reiniciará automáticamente cuando vuelvas a concederle el permiso."
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "KatiKati se reiniciará automáticamente cuando vuelvas a otorgarle el permiso."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O KatiKati será reiniciado sozinho assim que você conceder a permissão novamente."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "O KatiKati reinicia-se sozinho assim que voltar a conceder a permissão."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "KatiKati si riavvierà automaticamente dopo la nuova autorizzazione."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "다시 허용하면 KatiKati가 자동으로 재실행됩니다."
          }
        }
      }
    },
