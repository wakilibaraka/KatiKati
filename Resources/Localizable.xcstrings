    "Settings changed since you opened this window go back to their earlier values. KatiKati restarts to apply them.": {
      "extractionState": "manual",
      "localizations": {
        "en": {"stringUnit": {"state": "translated", "value": "Settings changed since you opened this window go back to their earlier values. KatiKati restarts to apply them."}},
        "zh-Hans": {"stringUnit": {"state": "needs_review", "value": "自打开此窗口以来更改的设置将恢复为之前的值。KatiKati 将重启以应用。"}},
        "zh-Hant": {"stringUnit": {"state": "needs_review", "value": "自開啟此視窗以來更改的設定將恢復為之前的值。KatiKati 將重新啟動以套用。"}},
        "ja": {"stringUnit": {"state": "needs_review", "value": "このウィンドウを開いてから変更した設定は以前の値に戻ります。適用のため KatiKati を再起動します。"}},
        "de": {"stringUnit": {"state": "needs_review", "value": "Seit dem Öffnen dieses Fensters geänderte Einstellungen werden auf ihre früheren Werte zurückgesetzt. KatiKati startet dafür neu."}},
        "fr": {"stringUnit": {"state": "needs_review", "value": "Les réglages modifiés depuis l’ouverture de cette fenêtre retrouvent leurs valeurs précédentes. KatiKati redémarre pour les appliquer."}},
        "es": {"stringUnit": {"state": "needs_review", "value": "Los ajustes cambiados desde que abriste esta ventana vuelven a sus valores anteriores. KatiKati se reinicia para aplicarlos."}},
        "es-419": {"stringUnit": {"state": "needs_review", "value": "Los ajustes cambiados desde que abriste esta ventana vuelven a sus valores anteriores. KatiKati se reinicia para aplicarlos."}},
        "pt-BR": {"stringUnit": {"state": "needs_review", "value": "As configurações alteradas desde que abriu esta janela voltam aos valores anteriores. O KatiKati reinicia para aplicá-las."}},
        "pt-PT": {"stringUnit": {"state": "needs_review", "value": "As definições alteradas desde que abriu esta janela voltam aos valores anteriores. O KatiKati reinicia para as aplicar."}},
        "it": {"stringUnit": {"state": "needs_review", "value": "Le impostazioni modificate da quando hai aperto questa finestra tornano ai valori precedenti. KatiKati si riavvia per applicarle."}},
        "ko": {"stringUnit": {"state": "needs_review", "value": "이 창을 연 이후 변경한 설정이 이전 값으로 돌아갑니다. 적용하려면 KatiKati가 다시 시작됩니다."}}
      }
    },
