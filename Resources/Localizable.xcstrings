    "Your previous settings were saved to the Backups folder first. Restart KatiKati to finish applying the restored ones.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your previous settings were saved to the Backups folder first. Restart KatiKati to finish applying the restored ones."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "恢复前已先把原有设置保存到“Backups”文件夹。重启 KatiKati 即可完成应用。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "還原前已先將原有設定儲存到「Backups」資料夾。重新啟動 KatiKati 即可完成套用。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "復元の前に、以前の設定を Backups フォルダに保存しました。KatiKati を再起動すると復元した設定が反映されます。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ihre bisherigen Einstellungen wurden zuvor im Ordner „Backups“ gesichert. Starten Sie KatiKati neu, um die wiederhergestellten Einstellungen zu übernehmen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vos réglages précédents ont d’abord été enregistrés dans le dossier Backups. Redémarrez KatiKati pour appliquer les réglages restaurés."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tus ajustes anteriores se guardaron antes en la carpeta Backups. Reinicia KatiKati para terminar de aplicar los restaurados."
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "Tus ajustes anteriores se guardaron antes en la carpeta Backups. Reinicia KatiKati para terminar de aplicar los restaurados."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Suas configurações anteriores foram salvas antes na pasta Backups. Reinicie o KatiKati para concluir a aplicação das restauradas."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "As suas definições anteriores foram guardadas primeiro na pasta Backups. Reinicie o KatiKati para concluir a aplicação das repostas."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le impostazioni precedenti sono state salvate prima nella cartella Backups. Riavvia KatiKati per applicare quelle ripristinate."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이전 설정은 먼저 Backups 폴더에 저장되었습니다. KatiKati를 다시 시작하면 복원된 설정이 적용됩니다."
          }
        }
      }
    },
