    "If the selector did not appear, allow Screen Recording for KatiKati in System Settings.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "If the selector did not appear, allow Screen Recording for KatiKati in System Settings."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "如果没有出现选区工具，请在“系统设置”中允许 KatiKati 录制屏幕。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "如果沒有出現選取工具，請在「系統設定」中允許 KatiKati 錄製螢幕。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "選択ツールが表示されない場合は、システム設定で KatiKati に画面収録を許可してください。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wenn die Auswahl nicht erscheint, erlaube KatiKati in den Systemeinstellungen die Bildschirmaufnahme."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Si le sélecteur n’apparaît pas, autorisez l’enregistrement de l’écran pour KatiKati dans Réglages Système."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Si no aparece el selector, permite a KatiKati la grabación de pantalla en Ajustes del Sistema."
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "Si no aparece el selector, permite a KatiKati la grabación de pantalla en Configuración del Sistema."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Se o seletor não aparecer, permita a gravação de tela para o KatiKati em Ajustes do Sistema."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Se o seletor não aparecer, permita a gravação do ecrã ao KatiKati nas Definições do Sistema."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Se il selettore non appare, consenti a KatiKati la registrazione dello schermo in Impostazioni di Sistema."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "선택 도구가 나타나지 않으면 시스템 설정에서 KatiKati의 화면 기록을 허용하세요."
          }
        }
      }
    },
