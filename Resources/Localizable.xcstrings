    "Auto uses Rose Quartz in light mode and Obsidian Dark in dark mode. Light or dark is set in General › Appearance.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Auto uses Rose Quartz in light mode and Obsidian Dark in dark mode. Light or dark is set in General › Appearance."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "自动：浅色模式用玫瑰石英，深色模式用黑曜石。浅色或深色在“通用 › 外观”中设置。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "自動：淺色模式用玫瑰石英，深色模式用黑曜石。淺色或深色在「一般 › 外觀」中設定。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "自動ではライトモードにローズクォーツ、ダークモードにオブシディアンを使います。ライト/ダークは「一般 › 外観」で設定します。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Automatisch nutzt Rosenquarz im hellen und Obsidian im dunklen Modus. Hell oder dunkel legst du unter Allgemein › Erscheinungsbild fest."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Auto utilise Quartz rose en mode clair et Obsidienne en mode sombre. Le mode clair ou sombre se règle dans Général › Apparence."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Automático usa Cuarzo rosa en modo claro y Obsidiana en modo oscuro. El modo claro u oscuro se ajusta en General › Apariencia."
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "Automático usa Cuarzo rosa en modo claro y Obsidiana en modo oscuro. El modo claro u oscuro se ajusta en General › Apariencia."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Automático usa Quartzo rosa no modo claro e Obsidiana no modo escuro. Claro ou escuro é definido em Geral › Aparência."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Automático usa Quartzo rosa no modo claro e Obsidiana no modo escuro. Claro ou escuro é definido em Geral › Aspeto."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Automatico usa Quarzo rosa in modalità chiara e Ossidiana in modalità scura. Chiaro o scuro si imposta in Generali › Aspetto."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "자동은 라이트 모드에서 로즈 쿼츠, 다크 모드에서 옵시디언을 사용합니다. 라이트 또는 다크는 일반 › 화면 모드에서 설정합니다."
          }
        }
      }
    },
