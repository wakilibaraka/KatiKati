    "A low-opacity wash over each thumbnail. It needs Screen Recording; without it, borders and badges still draw." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Eine transparente Farbwäsche über jeder Miniatur. Sie braucht Bildschirmaufnahme; ohne sie bleiben Rahmen und Etiketten."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A low-opacity wash over each thumbnail. It needs Screen Recording; without it, borders and badges still draw."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un velo de baja opacidad sobre cada miniatura. Requiere grabación de pantalla; sin ella, los bordes y distintivos siguen."
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un velo de baja opacidad sobre cada miniatura. Requiere grabación de pantalla; sin ella, los bordes y distintivos siguen."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un voile peu opaque sur chaque vignette. Nécessite l’enregistrement de l’écran ; sans lui, bordures et badges restent."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un velo a bassa opacità su ogni miniatura. Richiede la registrazione schermo; senza, bordi e badge restano."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "各サムネイルに低不透明度の色を重ねます。画面収録が必要で、なくても枠とバッジは表示されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "각 썸네일에 낮은 불투명도 색을 입힙니다. 화면 기록이 필요하며, 없어도 테두리와 배지는 표시됩니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Um véu de baixa opacidade sobre cada miniatura. Requer gravação de tela; sem ela, bordas e selos continuam."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Um véu de baixa opacidade sobre cada miniatura. Requer gravação do ecrã; sem ela, contornos e etiquetas continuam."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在每个缩略图上覆盖低透明度色调。需要屏幕录制；没有它，边框和徽标仍会显示。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在每個縮圖上覆蓋低透明度色調。需要螢幕錄製；沒有它，邊框和徽標仍會顯示。"
          }
        }
      }
    },
