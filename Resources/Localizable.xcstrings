    "Shows your open windows as chips and lets you switch to them.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Shows your open windows as chips and lets you switch to them."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "将打开的窗口显示为卡片，并让你切换到它们。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "將開啟的視窗顯示為卡片，並讓你切換到它們。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "開いているウインドウをチップとして表示し、切り替えられるようにします。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zeigt deine geöffneten Fenster als Chips an und ermöglicht den Wechsel dorthin."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Affiche vos fenêtres ouvertes sous forme de pastilles et permet d’y basculer."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Muestra tus ventanas abiertas como fichas y te permite cambiar a ellas."
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "Muestra tus ventanas abiertas como fichas y te permite cambiar a ellas."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Mostra as suas janelas abertas como chips e permite alternar entre elas."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Mostra as suas janelas abertas como chips e permite alternar entre elas."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Mostra le finestre aperte come chip e permette di passare da una all’altra."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "열린 창을 칩으로 표시하고 전환할 수 있게 합니다."
          }
        }
      }
    },
