    "Automatically trims labels, gaps, and icon scale when many windows are open to reduce scrolling." : {
      "localizations" : {
        "de" : { "stringUnit" : { "state" : "translated", "value" : "Kürzt Beschriftungen, Abstände und Symbolgröße automatisch bei vielen offenen Fenstern, um Scrollen zu vermeiden." } },
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Automatically trims labels, gaps, and icon scale when many windows are open to reduce scrolling." } },
        "es" : { "stringUnit" : { "state" : "translated", "value" : "Ajusta etiquetas, espacios y escala de iconos automáticamente al haber muchas ventanas para reducir el desplazamiento." } },
        "es-419" : { "stringUnit" : { "state" : "translated", "value" : "Ajusta etiquetas, espacios y escala de íconos automáticamente al haber muchas ventanas para reducir el desplazamiento." } },
        "fr" : { "stringUnit" : { "state" : "translated", "value" : "Réduit automatiquement les libellés, les espacements et l’échelle des icônes lorsque de nombreuses fenêtres sont ouvertes." } },
        "it" : { "stringUnit" : { "state" : "translated", "value" : "Riduce automaticamente etichette, spaziature e scala delle icone quando ci sono molte finestre aperte." } },
        "ja" : { "stringUnit" : { "state" : "translated", "value" : "多くのウインドウが開いているときにラベル幅・間隔・アイコン倍率を自動調整してスクロールを減らします。" } },
        "ko" : { "stringUnit" : { "state" : "translated", "value" : "열린 창이 많을 때 레이블, 간격 및 아이콘 크기를 자동으로 줄여 스크롤을 최소화합니다." } },
        "pt-BR" : { "stringUnit" : { "state" : "translated", "value" : "Reduz automaticamente rótulos, espaçamentos e escala dos ícones com muitas janelas abertas para evitar rolagem." } },
        "pt-PT" : { "stringUnit" : { "state" : "translated", "value" : "Ajusta automaticamente etiquetas, espaços e escala dos ícones com muitas janelas abertas para reduzir o deslocamento." } },
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "打开较多窗口时自动收缩标题、间距与图标缩放，尽量避免横向滚动。" } },
        "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "開啟較多視窗時自動收窄標題、間距與圖示比例，減少橫向捲動。" } }
      }
