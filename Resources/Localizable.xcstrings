    "Opens from ⌘Space (prompter). The window is hidden from screen recordings and shares.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Opens from ⌘Space (prompter). The window is hidden from screen recordings and shares."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "可从 ⌘Space 打开(prompter)。窗口不会出现在屏幕录制和共享中。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "可從 ⌘Space 開啟(prompter)。視窗不會出現在螢幕錄製與分享中。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "⌘Space(prompter)から開けます。ウィンドウは画面収録や共有に表示されません。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Öffnet über ⌘Space (prompter). Das Fenster erscheint nicht in Bildschirmaufnahmen und -freigaben."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "S’ouvre via ⌘Espace (prompter). La fenêtre n’apparaît pas dans les enregistrements ni les partages d’écran."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se abre con ⌘Space (prompter). La ventana no aparece en grabaciones ni al compartir pantalla."
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "Se abre con ⌘Space (prompter). La ventana no aparece en grabaciones ni al compartir pantalla."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Abre pelo ⌘Space (prompter). A janela não aparece em gravações nem no compartilhamento de tela."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Abre com ⌘Space (prompter). A janela não aparece em gravações nem na partilha de ecrã."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Si apre con ⌘Space (prompter). La finestra non compare nelle registrazioni né nelle condivisioni."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "⌘Space(prompter)로 열 수 있어요. 창은 화면 녹화 및 공유에 나타나지 않습니다."
          }
        }
      }
    },
