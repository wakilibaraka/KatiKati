    "Only the name of the front app and the time it was in front are kept, on this Mac.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Only the name of the front app and the time it was in front are kept, on this Mac."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "仅在此 Mac 上保存前台应用的名称及其位于前台的时间。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "僅在此 Mac 上儲存前景 App 的名稱及其位於前景的時間。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "最前面のAppの名前とその使用時間のみを、このMac上に保存します。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nur der Name der vordersten App und ihre Vordergrundzeit werden gespeichert – auf diesem Mac."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Seuls le nom de l’app au premier plan et la durée au premier plan sont conservés, sur ce Mac."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Solo se guardan, en este Mac, el nombre de la app en primer plano y el tiempo que estuvo en primer plano."
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "Solo se guardan, en esta Mac, el nombre de la app en primer plano y el tiempo que estuvo en primer plano."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Apenas o nome do app em primeiro plano e o tempo em que ficou em primeiro plano são guardados, neste Mac."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Apenas o nome da app em primeiro plano e o tempo em que esteve em primeiro plano são guardados, neste Mac."
          }
        },
        "it": {
