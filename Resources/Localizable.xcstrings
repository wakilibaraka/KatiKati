    "Merge keeps local items the server does not have. Snapshot-Faithful replaces the selected parts with the server's copy." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zusammenführen behält lokale Einträge, die der Server nicht hat. Originalgetreue Momentaufnahme ersetzt die gewählten Teile durch die Serverkopie."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Merge keeps local items the server does not have. Snapshot-Faithful replaces the selected parts with the server's copy."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Combinar conserva los elementos locales que no están en el servidor. La instantánea fiel sustituye las partes seleccionadas por la copia del servidor."
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Combinar conserva los elementos locales que no están en el servidor. La instantánea fiel sustituye las partes seleccionadas por la copia del servidor."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fusionner conserve les éléments locaux absents du serveur. L'instantané fidèle remplace les parties choisies par la copie du serveur."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Unisci conserva gli elementi locali assenti dal server. L'istantanea fedele sostituisce le parti selezionate con la copia del server."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "マージはサーバーにないローカル項目を保持します。忠実スナップショットは選択部分をサーバーのコピーで置き換えます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "병합은 서버에 없는 로컬 항목을 유지합니다. 충실한 스냅샷은 선택한 부분을 서버 복사본으로 바꿉니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Combinar mantém os itens locais que o servidor não tem. A cópia fiel substitui as partes selecionadas pela cópia do servidor."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Combinar mantém os itens locais que o servidor não tem. A cópia fiel substitui as partes selecionadas pela cópia do servidor."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "合并会保留服务器上没有的本地项目；忠实快照会用服务器的副本替换所选部分。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "合併會保留伺服器上沒有的本機項目；忠實快照會用伺服器的副本取代所選部分。"
          }
        }
      }
    },
