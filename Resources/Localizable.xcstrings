    "Background Apps lists running apps that have no window. Apple helper processes stay hidden unless this is on.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Hintergrund-Apps listet laufende Apps ohne Fenster auf. Apple-Hilfsprozesse bleiben ausgeblendet, solange dies nicht aktiviert ist."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Background Apps lists running apps that have no window. Apple helper processes stay hidden unless this is on."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Apps en segundo plano muestra las apps en ejecución sin ventana. Los procesos auxiliares de Apple permanecen ocultos salvo que esto esté activado."
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "Apps en segundo plano muestra las apps en ejecución sin ventana. Los procesos auxiliares de Apple permanecen ocultos a menos que esto esté activado."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les apps en arrière-plan listent les apps ouvertes sans fenêtre. Les processus d’assistance Apple restent masqués sauf si cette option est activée."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "App in background elenca le app in esecuzione senza finestra. I processi helper di Apple restano nascosti a meno che questa opzione sia attiva."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "「バックグラウンドApp」にはウインドウのない実行中のAppが表示されます。オンにしない限り、Appleのヘルパープロセスは表示されません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "백그라운드 앱은 창이 없는 실행 중인 앱을 보여 줍니다. 이 옵션을 켜지 않으면 Apple 도우미 프로세스는 숨겨집니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Apps em segundo plano lista os apps em execução sem janela. Os processos auxiliares da Apple ficam ocultos, a menos que isto esteja ativado."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "As apps em segundo plano listam as apps em execução sem janela. Os processos auxiliares da Apple ficam ocultos, a não ser que isto esteja ativado."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "“后台 App”列出没有窗口的运行中 App。除非开启此项，否则 Apple 辅助进程保持隐藏。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "「背景 App」列出沒有視窗的執行中 App。除非開啟此項，否則 Apple 輔助程序保持隱藏。"
          }
        }
      }
    },
