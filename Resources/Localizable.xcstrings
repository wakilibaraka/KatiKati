        "es" : { "stringUnit" : { "state" : "translated", "value" : "Preajustes de ventanas, espaciado, redimensión dinámica, grupos y respuesta al cursor." } },
        "es-419" : { "stringUnit" : { "state" : "translated", "value" : "Preajustes de ventanas, espaciado, redimensión dinámica, grupos y respuesta al cursor." } },
        "fr" : { "stringUnit" : { "state" : "translated", "value" : "Préréglages d’instances, espacement, taille dynamique, groupes et survol." } },
        "it" : { "stringUnit" : { "state" : "translated", "value" : "Preset istanze, spaziatura, ridimensionamento dinamico, gruppi e passaggio." } },
        "ja" : { "stringUnit" : { "state" : "translated", "value" : "表示プリセット、間隔、動的リサイズ、アプリグループ、ホバー反応。" } },
        "ko" : { "stringUnit" : { "state" : "translated", "value" : "인스턴스 프리셋, 간격, 동적 크기 조절, 앱 그룹 및 호버 반응." } },
        "pt-BR" : { "stringUnit" : { "state" : "translated", "value" : "Predefinições de janelas, espaçamento, tamanho dinâmico, grupos e foco ao passar." } },
        "pt-PT" : { "stringUnit" : { "state" : "translated", "value" : "Predefinições de janelas, espaçamento, tamanho dinâmico, grupos e passagem." } },
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "多窗口预设、间距、动态防溢出缩放、应用分组与悬停反馈。" } },
        "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "多視窗預設、間距、動態防溢位縮放、App 群組與懸停回饋。" } }
      }
    },
    "Keep in Dock is the default. Enable this legacy option to also show separate icon pinning." : {
      "localizations" : {
        "de" : { "stringUnit" : { "state" : "translated", "value" : "„Im Dock behalten“ ist der Standard. Aktiviere diese klassische Option für separates Symbol-Anheften." } },
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Keep in Dock is the default. Enable this legacy option to also show separate icon pinning." } },
        "es" : { "stringUnit" : { "state" : "translated", "value" : "Mantener en el Dock es el predeterminado. Activa esta opción clásica para fijar iconos por separado." } },
        "es-419" : { "stringUnit" : { "state" : "translated", "value" : "Mantener en el Dock es el predeterminado. Activa esta opción clásica para fijar íconos por separado." } },
        "fr" : { "stringUnit" : { "state" : "translated", "value" : "Garder dans le Dock est l’option par défaut. Activez cette option héritée pour l’épinglage d’icône distinct." } },
        "it" : { "stringUnit" : { "state" : "translated", "value" : "Mantieni nel Dock è predefinito. Attiva questa opzione classica per mostrare anche il fissaggio icona separato." } },
        "ja" : { "stringUnit" : { "state" : "translated", "value" : "「Dock に追加」が既定です。従来のアイコン単体固定も表示するには有効にしてください。" } },
        "ko" : { "stringUnit" : { "state" : "translated", "value" : "‘Dock에 유지’가 기본값입니다. 별도 아이콘 고정 메뉴도 표시하려면 이 레거시 옵션을 켜세요." } },
        "pt-BR" : { "stringUnit" : { "state" : "translated", "value" : "Manter no Dock é o padrão. Ative esta opção clássica para mostrar também a fixação separada." } },
        "pt-PT" : { "stringUnit" : { "state" : "translated", "value" : "Manter na Dock é a predefinição. Ative esta opção clássica para mostrar também a fixação separada." } },
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "默认只显示“在程序坞中保留”；开启此传统选项后同时显示单独的图标固定。" } },
        "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "預設僅顯示「保留在 Dock 中」；啟用此舊版選項後可同時顯示獨立圖示釘選。" } }
      }
    },
    "Left and right flanking wings, Battery & Peripherals, and floating stack." : {
      "localizations" : {
        "de" : { "stringUnit" : { "state" : "translated", "value" : "Linke und rechte Flügel, Batterie & Peripheriegeräte und schwebender Stapel." } },
