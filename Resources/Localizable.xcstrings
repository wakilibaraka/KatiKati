          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ピン留めされていないシェルフ項目を消去しますか？"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nicht angeheftete Shelf-Einträge löschen?"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Effacer les éléments non épinglés du plateau ?"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¿Borrar los elementos no fijados del estante?"
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "¿Borrar los elementos no fijados del estante?"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Limpar itens não fixados da prateleira?"
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Limpar itens não fixados da prateleira?"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Cancellare gli elementi non fissati del ripiano?"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "고정되지 않은 선반 항목을 지울까요?"
          }
        }
      }
    },
    "Unpinned entries leave the shelf and its own copies are deleted. Pinned items stay.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Unpinned entries leave the shelf and its own copies are deleted. Pinned items stay."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "未固定的项目会离开搁板，其自身副本会被删除。固定项会保留。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "未固定的項目會離開擱板，其自身副本會被刪除。固定項目會保留。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ピン留めされていない項目はシェルフから外れ、自身のコピーは削除されます。ピン留めした項目は残ります。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nicht angeheftete Einträge verlassen das Shelf und eigene Kopien werden gelöscht. Angeheftete Einträge bleiben."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les éléments non épinglés quittent le plateau et ses propres copies sont supprimées. Les éléments épinglés restent."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los elementos no fijados salen del estante y sus propias copias se eliminan. Los elementos fijados se quedan."
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "Los elementos no fijados salen del estante y sus propias copias se eliminan. Los elementos fijados se quedan."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Itens não fixados saem da prateleira e suas próprias cópias são apagadas. Itens fixados ficam."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Itens não fixados saem da prateleira e as suas próprias cópias são apagadas. Itens fixados ficam."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Gli elementi non fissati lasciano il ripiano e le sue copie vengono eliminate. Gli elementi fissati restano."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "고정되지 않은 항목은 선반에서 사라지고 자체 사본도 삭제됩니다. 고정된 항목은 남습니다."
          }
        }
      }
    },
