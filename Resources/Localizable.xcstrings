            "state": "translated",
            "value": "無法讀取其中一個附件。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "添付ファイルのうち1つを読み込めませんでした。"
          }
        },
        "de": {
