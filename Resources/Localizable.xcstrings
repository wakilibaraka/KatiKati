    "Choose how the bar sits at the bottom of your screen. You can change it any time in Settings or from the menu bar.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Choose how the bar sits at the bottom of your screen. You can change it any time in Settings or from the menu bar."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "选择任务栏在屏幕底部的样子。之后可随时在设置或菜单栏中更改。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "選擇工作列在螢幕底部的樣子。之後可隨時在設定或選單列中更改。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "画面下部のバーの配置を選びます。設定やメニューバーからいつでも変更できます。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wähle, wie die Leiste am unteren Bildschirmrand sitzt. Du kannst das jederzeit in den Einstellungen oder über die Menüleiste ändern."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Choisissez la disposition de la barre en bas de l’écran. Vous pourrez la modifier à tout moment dans les réglages ou la barre des menus."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Elige cómo se coloca la barra en la parte inferior de la pantalla. Puedes cambiarlo cuando quieras en Ajustes o desde la barra de menús."
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "Elige cómo se coloca la barra en la parte inferior de la pantalla. Puedes cambiarlo cuando quieras en Configuración o desde la barra de menús."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Escolha como a barra fica na parte inferior da tela. Você pode mudar quando quiser nos Ajustes ou pela barra de menus."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Escolha como a barra fica na parte inferior do ecrã. Pode alterar a qualquer momento nas Definições ou na barra de menus."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Scegli come appare la barra in fondo allo schermo. Puoi cambiarlo in qualsiasi momento nelle Impostazioni o dalla barra dei menu."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "화면 아래쪽 막대의 배치를 선택하세요. 언제든지 설정이나 메뉴 막대에서 바꿀 수 있습니다."
          }
        }
      }
    },
