    "Star KatiKati on GitHub — a free way to help it get better.": {
      "comment": "⚠️ 中文与官网 tungstenedge.app 订阅区下面那句 Star 请求逐字同源，改这里就要同步改官网。调子必须比上面订阅正文更淡——它是顺手帮个忙，不能压过留邮箱的真实理由。",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Star KatiKati on GitHub — a free way to help it get better."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在 GitHub 点个免费的 Star，支持KatiKati变得更好。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "到GitHub給KatiKati一顆星——不花錢也能幫它變得更好。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "GitHubでKatiKatiにStarを付けると、無料で開発を応援できます。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Gib KatiKati auf GitHub einen Stern – so unterstützt du die Weiterentwicklung, ohne Geld auszugeben."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Mettez une étoile à KatiKati sur GitHub — un coup de pouce gratuit pour l’aider à progresser."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Dale una estrella a KatiKati en GitHub: una forma gratuita de ayudar a que mejore."
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "Dale una estrella a KatiKati en GitHub: una forma gratuita de ayudar a que mejore."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Dê uma estrela ao KatiKati no GitHub — um jeito gratuito de ajudar a melhorá-lo."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Dê uma estrela ao KatiKati no GitHub – uma forma gratuita de ajudar a melhorá-lo."
          }
        },
        "it": {
          "stringUnit": {
