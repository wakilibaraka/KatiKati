    "One style for the wallpaper, the lock-screen card and the desktop widget. Turn off for per-surface overrides." : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "One style for the wallpaper, the lock-screen card and the desktop widget. Turn off for per-surface overrides." } },
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "壁纸、锁屏卡片与桌面小组件共用一种样式。关闭后可分别设置。" } },
        "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "桌布、鎖定畫面卡片與桌面小工具共用一種樣式。關閉後可分別設定。" } },
        "ja" : { "stringUnit" : { "state" : "translated", "value" : "壁紙・ロック画面カード・デスクトップウィジェットで1つのスタイルを共有します。オフにすると個別に設定できます。" } },
        "de" : { "stringUnit" : { "state" : "translated", "value" : "Ein Stil für Hintergrund, Sperrbildschirm-Karte und Widget. Ausschalten für Abweichungen pro Fläche." } },
        "fr" : { "stringUnit" : { "state" : "translated", "value" : "Un seul style pour le fond, la carte de verrouillage et le widget. Désactivez pour des réglages par surface." } },
        "es" : { "stringUnit" : { "state" : "translated", "value" : "Un solo estilo para el fondo, la tarjeta de bloqueo y el widget. Desactiva para ajustar cada superficie." } },
        "es-419" : { "stringUnit" : { "state" : "translated", "value" : "Un solo estilo para el fondo, la tarjeta de bloqueo y el widget. Desactiva para ajustar cada superficie." } },
        "pt-BR" : { "stringUnit" : { "state" : "translated", "value" : "Um estilo para o papel de parede, o cartão de bloqueio e o widget. Desative para ajustar cada superfície." } },
        "pt-PT" : { "stringUnit" : { "state" : "translated", "value" : "Um estilo para o papel de parede, o cartão de bloqueio e o widget. Desative para ajustar cada superfície." } },
        "it" : { "stringUnit" : { "state" : "translated", "value" : "Un solo stile per sfondo, scheda di blocco e widget. Disattiva per regolazioni separate." } },
        "ko" : { "stringUnit" : { "state" : "translated", "value" : "배경화면, 잠금 화면 카드, 데스크탑 위젯이 한 스타일을 공유합니다. 끄면 각각 설정할 수 있습니다." } }
