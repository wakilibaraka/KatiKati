    "Instructs WindowServer to commit window level changes in the same screen refresh frame.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Instructs WindowServer to commit window level changes in the same screen refresh frame."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "通知 WindowServer 在当前屏幕刷新帧内立即应用窗口层级调整，消除延迟。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "通知 WindowServer 在當前螢幕刷新訊框內立即套用視窗層級調整，消除延遲。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "WindowServer に同じ描画フレーム内でウィンドウ階層の変更を反映させ、遅延を防止します。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Weist den WindowServer an, Ebenenänderungen im selben Bildwiederholungszyklus anzuwenden."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Demande à WindowServer d'appliquer les changements d'étage dans la même trame de rafraîchissement."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Indica a WindowServer que aplique los cambios de nivel en el mismo cuadro de refresco de pantalla."
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "translated",
