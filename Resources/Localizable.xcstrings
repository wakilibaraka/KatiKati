            "value" : "懸浮在視窗上方的小圓球：點擊開啟啟動台，拖曳可放到任意位置。"
          }
        }
      }
    },
    "A system sound plays with every alert when it is on." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wenn aktiviert, ertönt bei jedem Hinweis ein Systemton."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A system sound plays with every alert when it is on."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Con la opción activada, cada aviso reproduce un sonido del sistema."
          }
        },
