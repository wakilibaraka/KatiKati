            "value" : "macOS l'exige avant que KatiKati puisse déplacer les fenêtres d'autres apps."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "macOS lo richiede prima che KatiKati possa spostare le finestre di altre app."
          }
