        "es" : { "stringUnit" : { "state" : "translated", "value" : "Alas laterales izquierda y derecha, batería y periféricos y pila flotante." } },
        "es-419" : { "stringUnit" : { "state" : "translated", "value" : "Alas laterales izquierda y derecha, batería y periféricos y pila flotante." } },
        "fr" : { "stringUnit" : { "state" : "translated", "value" : "Ailes gauche et droite, batterie et périphériques, et pile flottante." } },
        "it" : { "stringUnit" : { "state" : "translated", "value" : "Ali laterali sinistra e destra, batteria e periferiche e pila mobile." } },
        "ja" : { "stringUnit" : { "state" : "translated", "value" : "左右のウィング、バッテリーと周辺機器、フローティングスタック。" } },
        "ko" : { "stringUnit" : { "state" : "translated", "value" : "좌우 윙, 배터리 및 주변기기, 플로팅 스택." } },
        "pt-BR" : { "stringUnit" : { "state" : "translated", "value" : "Asas laterais esquerda e direita, bateria e periféricos e pilha flutuante." } },
        "pt-PT" : { "stringUnit" : { "state" : "translated", "value" : "Asas laterais esquerda e direita, bateria e periféricos e pilha flutuante." } },
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "左右侧翼、电池与外设，以及悬浮小组件堆叠。" } },
        "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "左右側翼、電池與週邊裝置，以及懸浮小工具堆疊。" } }
      }
