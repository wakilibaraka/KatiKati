    "Right-click a window chip for a floating jump list above the dock. Turn this on to use the system menu instead." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rechtsklick auf einen Fenster-Chip öffnet eine schwebende Liste über dem Dock. Aktivieren, um stattdessen das Systemmenü zu verwenden."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Right-click a window chip for a floating jump list above the dock. Turn this on to use the system menu instead."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Haz clic derecho en una ficha de ventana para ver una lista flotante sobre el Dock. Actívalo para usar el menú del sistema."
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Haz clic derecho en una ficha de ventana para ver una lista flotante sobre el Dock. Actívalo para usar el menú del sistema."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un clic droit sur une pastille ouvre une liste flottante au-dessus du Dock. Activez cette option pour utiliser le menu système."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fai clic destro su un chip finestra per una lista flottante sopra il Dock. Attiva per usare il menu di sistema."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ウインドウチップを右クリックすると、Dockの上にジャンプリストが表示されます。オンにするとシステムメニューを使います。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "창 칩을 오른쪽 클릭하면 Dock 위에 떠 있는 목록이 나타납니다. 켜면 시스템 메뉴를 사용합니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Clique com o botão direito num chip de janela para ver uma lista flutuante acima do Dock. Ative para usar o menu do sistema."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Clique com o botão direito num chip de janela para ver uma lista flutuante acima do Dock. Ative para usar o menu do sistema."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "右键点击窗口卡片会在程序坞上方弹出浮动列表。开启此项则改用系统菜单。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在視窗卡片上按右鍵會在 Dock 上方彈出浮動列表。開啟此項則改用系統選單。"
          }
        }
      }
    },
    "Right-click an item to Zip, Compress, Share or AirDrop." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rechtsklicke ein Objekt, um es zu zippen, zu komprimieren, zu teilen oder per AirDrop zu senden."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Right-click an item to Zip, Compress, Share or AirDrop."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Haz clic derecho en un elemento para comprimirlo, zipearlo, compartirlo o enviarlo por AirDrop."
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Haz clic derecho en un elemento para comprimirlo, zipearlo, compartirlo o enviarlo por AirDrop."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Faites un clic droit sur un élément pour le zipper, le compresser, le partager ou l’envoyer par AirDrop."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fai clic destro su un elemento per comprimerlo in Zip, ottimizzarlo, condividerlo o inviarlo con AirDrop."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "項目を右クリックすると、Zip・圧縮・共有・AirDropができます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "항목을 오른쪽 클릭하면 압축, 용량 줄이기, 공유, AirDrop을 사용할 수 있습니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Clique com o botão direito em um item para compactar, comprimir, compartilhar ou enviar por AirDrop."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Clique com o botão direito num item para compactar, comprimir, partilhar ou enviar por AirDrop."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "右键点按项目即可压缩、打包、共享或隔空投送。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "右鍵點按項目即可壓縮、打包、分享或使用 AirDrop。"
          }
        }
      }
    },
