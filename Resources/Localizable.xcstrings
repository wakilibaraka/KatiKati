    "Saves your settings, shortcuts, bar layout and tasks to one file. Notes are not included.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Saves your settings, shortcuts, bar layout and tasks to one file. Notes are not included."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "把设置、快捷键、任务条布局和任务保存到一个文件。笔记不包含在内。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "將設定、快速鍵、工作列配置和任務儲存到一個檔案。筆記不包含在內。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "設定、ショートカット、バーのレイアウト、タスクを1つのファイルに保存します。メモは含まれません。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Speichert Einstellungen, Kurzbefehle, Leistenlayout und Aufgaben in einer Datei. Notizen sind nicht enthalten."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Enregistre vos réglages, raccourcis, la disposition de la barre et vos tâches dans un seul fichier. Les notes n’y sont pas incluses."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Guarda tus ajustes, atajos, la disposición de la barra y las tareas en un solo archivo. Las notas no se incluyen."
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "Guarda tus ajustes, atajos, la disposición de la barra y las tareas en un solo archivo. Las notas no se incluyen."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Salva suas configurações, atalhos, o layout da barra e as tarefas em um único arquivo. As notas não estão incluídas."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Guarda as suas definições, atalhos, a disposição da barra e as tarefas num único ficheiro. As notas não estão incluídas."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Salva impostazioni, scorciatoie, layout della barra e attività in un unico file. Le note non sono incluse."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "설정, 단축키, 바 레이아웃, 할 일을 하나의 파일로 저장합니다. 메모는 포함되지 않습니다."
          }
        }
