    "Spiral: each new window takes half of the space left, turning clockwise.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Spiral: each new window takes half of the space left, turning clockwise."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "螺旋：每个新窗口占据剩余空间的一半，顺时针排列。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "螺旋：每個新視窗佔據剩餘空間的一半，順時針排列。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "スパイラル：新しいウィンドウが空きスペースの半分を占め、時計回りに配置されます。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Spirale: Jedes neue Fenster nimmt die Hälfte des verbleibenden Platzes, im Uhrzeigersinn."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Spirale : chaque nouvelle fenêtre prend la moitié de l’espace restant, dans le sens horaire."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Espiral: cada ventana nueva ocupa la mitad del espacio restante, en sentido horario."
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "Espiral: cada ventana nueva ocupa la mitad del espacio restante, en sentido horario."
