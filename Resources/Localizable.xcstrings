    "Names, borders, colours and hover actions are drawn only while the overview is open. Detection is event-driven, so nothing polls or uses CPU while Mission Control is closed." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Namen, Rahmen, Farben und Hover-Aktionen erscheinen nur, solange die Übersicht offen ist. Die Erkennung läuft ereignisgesteuert – bei geschlossenem Mission Control wird nicht abgefragt und keine CPU verbraucht."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Names, borders, colours and hover actions are drawn only while the overview is open. Detection is event-driven, so nothing polls or uses CPU while Mission Control is closed."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los nombres, bordes, colores y acciones al pasar el puntero solo se dibujan mientras la vista general está abierta. La detección se basa en eventos: no hay sondeos ni uso de CPU con Mission Control cerrado."
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los nombres, bordes, colores y acciones al pasar el puntero solo se dibujan mientras la vista general está abierta. La detección se basa en eventos: no hay sondeos ni uso de CPU con Mission Control cerrado."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les noms, bordures, couleurs et actions au survol ne s’affichent que tant que la vue d’ensemble est ouverte. La détection est événementielle : aucun sondage ni consommation de CPU quand Mission Control est fermé."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nomi, bordi, colori e azioni al passaggio del puntatore compaiono solo mentre la panoramica è aperta. Il rilevamento è basato su eventi: a Mission Control chiuso non c’è polling né consumo di CPU."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "名前、枠、色、ホバーアクションは概要を開いている間だけ描画されます。検出はイベント駆動なので、Mission Control が閉じている間はポーリングも CPU 使用もありません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이름, 테두리, 색상 및 호버 동작은 개요가 열려 있는 동안에만 표시됩니다. 감지는 이벤트 기반이라 Mission Control이 닫혀 있으면 폴링도 CPU 사용도 없습니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nomes, bordas, cores e ações ao passar o ponteiro só aparecem enquanto a visão geral está aberta. A detecção é por eventos: nada consulta nem usa CPU com o Mission Control fechado."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nomes, contornos, cores e ações ao passar o ponteiro só aparecem enquanto a vista geral está aberta. A deteção é por eventos: nada consulta nem usa CPU com o Mission Control fechado."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "仅在概览打开时绘制名称、边框、颜色和悬停操作。检测由事件驱动，因此调度中心关闭时不会轮询，也不占用 CPU。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "僅在概覽開啟時繪製名稱、邊框、顏色和懸停操作。偵測由事件驅動，因此調度中心關閉時不會輪詢，也不佔用 CPU。"
          }
        }
      }
    },
    "Close, minimize, zoom, hide and quit act on the hovered window through its own Accessibility buttons." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Schließen, Minimieren, Zoomen, Ausblenden und Beenden wirken über die eigenen Bedienungshilfen-Schaltflächen auf das Fenster unter dem Zeiger."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Close, minimize, zoom, hide and quit act on the hovered window through its own Accessibility buttons."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cerrar, minimizar, ampliar, ocultar y salir actúan sobre la ventana bajo el puntero mediante sus propios botones de Accesibilidad."
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cerrar, minimizar, ampliar, ocultar y salir actúan sobre la ventana bajo el puntero mediante sus propios botones de Accesibilidad."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fermer, réduire, zoomer, masquer et quitter agissent sur la fenêtre survolée via ses propres boutons d’accessibilité."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chiudi, riduci a icona, zoom, nascondi ed esci agiscono sulla finestra sotto il puntatore tramite i suoi pulsanti Accessibilità."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "閉じる、しまう、ズーム、隠す、終了は、ポインタ下のウインドウ自身のアクセシビリティボタンで実行します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "닫기, 최소화, 확대, 가리기, 종료는 포인터 아래 윈도우의 자체 손쉬운 사용 버튼으로 수행합니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fechar, minimizar, ampliar, ocultar e encerrar agem na janela sob o ponteiro pelos próprios botões de Acessibilidade."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fechar, minimizar, ampliar, ocultar e terminar atuam na janela sob o ponteiro através dos próprios botões de Acessibilidade."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "关闭、最小化、缩放、隐藏和退出都通过悬停窗口自身的辅助功能按钮执行。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "關閉、最小化、縮放、隱藏和結束都透過懸停視窗自身的輔助使用按鈕執行。"
          }
        }
      }
    },
    "Optional: only the thumbnail tint wash needs it. Borders, badges and actions work without it." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Optional: Nur die Farbwäsche der Miniaturen braucht sie. Rahmen, Etiketten und Aktionen funktionieren ohne."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Optional: only the thumbnail tint wash needs it. Borders, badges and actions work without it."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Opcional: solo la capa de tinte de las miniaturas la necesita. Los bordes, distintivos y acciones funcionan sin ella."
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Opcional: solo la capa de tinte de las miniaturas la necesita. Los bordes, distintivos y acciones funcionan sin ella."
          }
        },
        "fr" : {
          "stringUnit" : {
