    "Custom bundle-ID rules beat category colours, which beat the neutral default." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Eigene Bundle-ID-Regeln schlagen Kategoriefarben, diese den neutralen Standard."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Custom bundle-ID rules beat category colours, which beat the neutral default."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las reglas de bundle ID vencen a los colores de categoría, que vencen al valor neutro."
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las reglas de bundle ID vencen a los colores de categoría, que vencen al valor neutro."
          }
        },
        "fr" : {
          "stringUnit" : {
