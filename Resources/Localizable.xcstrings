    "Liquid uses metaball physics and detached balls; Full and Compact preserve classic layouts." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Liquid nutzt Metaball-Physik und gelöste Bälle; Voll und Kompakt bewahren klassische Layouts."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Liquid uses metaball physics and detached balls; Full and Compact preserve classic layouts."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Liquid usa física metaball y burbujas separadas; Completo y Compacto conservan el diseño clásico."
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Liquid usa física metaball y burbujas separadas; Completo y Compacto conservan el diseño clásico."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Liquid utilise une physique métaballe et des bulles détachées ; Complet et Compact gardent les dispositions classiques."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Liquid usa fisica metaball e sfere separate; Completo e Compatto mantengono i layout classici."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Liquid はメタボール物理と分離ボールを使用し、フルとコンパクトは従来のレイアウトを保持します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Liquid는 메타볼 물리 효과와 분리형 볼을 사용하며 전체 및 컴팩트는 기존 레이아웃을 유지합니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Liquid usa física metaball e esferas separadas; Completo e Compacto mantêm os layouts clássicos."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Liquid usa física metaball e esferas separadas; Completo e Compacto mantêm os esquemas clássicos."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "流体使用融球物理与独立活动球；完整与紧凑保留经典布局。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "流體使用融球物理與獨立活動球；完整與精簡保留經典版面。"
          }
        }
      }
    },
    "Optional modules stay off until enabled for zero idle CPU." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Optionale Module bleiben deaktiviert, bis sie für null Leerlauf-CPU eingeschaltet werden."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Optional modules stay off until enabled for zero idle CPU."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los módulos opcionales permanecen desactivados hasta activarse para mantener 0 % de CPU en reposo."
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los módulos opcionales permanecen desactivados hasta activarse para mantener 0 % de CPU en reposo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les modules optionnels restent désactivés jusqu’à leur activation pour une CPU nulle au repos."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I moduli opzionali restano disattivati finché non vengono abilitati per zero CPU a riposo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "オプションモジュールは有効化するまでオフのままで、アイドル時 CPU 負荷ゼロを維持します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "선택 모듈은 활성화할 때까지 꺼져 있어 유휴 CPU 사용량을 0으로 유지합니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Módulos opcionais permanecem desligados até serem ativados para manter CPU ociosa em zero."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Os módulos opcionais permanecem desligados até serem ativados para manter a CPU inativa a zero."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "可选模块默认关闭，启用前零后台 CPU 占用。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "可選模組預設關閉，啟用前零背景 CPU 佔用。"
          }
        }
      }
    },
