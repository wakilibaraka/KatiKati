    "Shows live window thumbnails in hover previews. Without it, previews show titles only." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zeigt Live-Fenstervorschauen in den Hover-Vorschauen. Ohne sie werden nur Titel angezeigt."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Shows live window thumbnails in hover previews. Without it, previews show titles only."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Muestra miniaturas de ventanas en vivo en las vistas previas. Sin ella, solo se muestran los títulos."
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Muestra miniaturas de ventanas en vivo en las vistas previas. Sin ella, solo se muestran los títulos."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Affiche des miniatures de fenêtres en direct dans les aperçus au survol. Sans elle, seuls les titres s’affichent."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mostra miniature live delle finestre nelle anteprime. Senza, vengono mostrati solo i titoli."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ホバープレビューにウインドウのライブサムネイルを表示します。許可がない場合はタイトルのみ表示されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "호버 미리보기에 창의 실시간 썸네일을 표시합니다. 권한이 없으면 제목만 표시됩니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mostra miniaturas de janelas em tempo real nas pré-visualizações. Sem ela, só aparecem os títulos."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mostra miniaturas de janelas em tempo real nas pré-visualizações. Sem ela, só aparecem os títulos."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在悬停预览中显示窗口实时缩略图；没有此权限时只显示标题。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在懸停預覽中顯示視窗即時縮圖；沒有此權限時只顯示標題。"
          }
        }
      }
    },
    "Shows Mac and Bluetooth accessories. macOS does not share iPhone or Apple Watch battery levels with third-party apps." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zeigt Mac- und Bluetooth-Zubehör an. macOS teilt die Akkustände von iPhone oder Apple Watch nicht mit Drittanbieter-Apps."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Shows Mac and Bluetooth accessories. macOS does not share iPhone or Apple Watch battery levels with third-party apps."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Muestra el Mac y los accesorios Bluetooth. macOS no comparte los niveles de batería del iPhone o Apple Watch con apps de terceros."
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Muestra la Mac y los accesorios Bluetooth. macOS no comparte los niveles de batería del iPhone o Apple Watch con apps de terceros."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Affiche le Mac et les accessoires Bluetooth. macOS ne partage pas le niveau de batterie de l’iPhone ou de l’Apple Watch avec les apps tierces."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mostra il Mac e gli accessori Bluetooth. macOS non condivide i livelli della batteria di iPhone o Apple Watch con app di terze parti."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mac と Bluetooth アクセサリを表示します。macOS では iPhone や Apple Watch のバッテリー残量はサードパーティ製アプリに共有されません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mac 및 Bluetooth 액세서리를 표시합니다. macOS는 iPhone 또는 Apple Watch 배터리 잔량을 서드파티 앱과 공유하지 않습니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mostra o Mac e acessórios Bluetooth. O macOS não compartilha os níveis de bateria do iPhone ou Apple Watch com apps de terceiros."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mostra o Mac e acessórios Bluetooth. O macOS não partilha os níveis de bateria do iPhone ou Apple Watch com apps de terceiros."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "显示 Mac 与蓝牙配件的电量。macOS 不向第三方应用开放 iPhone 或 Apple Watch 的电池百分比。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "顯示 Mac 與藍牙配件的電量。macOS 不會將 iPhone 或 Apple Watch 的電池電量分享給第三方 App。"
          }
        }
      }
    },
    "Shows or hides the Dynamic Notch at the top of the screen." : {
