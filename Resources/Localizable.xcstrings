    "Exact values for power users. Bar height is capped at what still fits this screen.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Exact values for power users. Bar height is capped at what still fits this screen."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "供高级用户使用的精确数值。栏高上限为此屏幕仍能容纳的高度。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "供進階使用者使用的精確數值。列高上限為此螢幕仍能容納的高度。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "上級者向けの正確な値です。バーの高さは、この画面に収まる範囲が上限です。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Genaue Werte für Profis. Die Leistenhöhe ist auf das begrenzt, was auf diesen Bildschirm passt."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Valeurs exactes pour les utilisateurs avancés. La hauteur de la barre est limitée à ce qui tient sur cet écran."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Valores exactos para usuarios avanzados. La altura de la barra se limita a lo que cabe en esta pantalla."
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "Valores exactos para usuarios avanzados. La altura de la barra se limita a lo que cabe en esta pantalla."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Valores exatos para usuários avançados. A altura da barra é limitada ao que ainda cabe nesta tela."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Valores exatos para utilizadores avançados. A altura da barra é limitada ao que ainda cabe neste ecrã."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Valori esatti per utenti esperti. L'altezza della barra è limitata a ciò che sta ancora su questo schermo."
          }
        },
        "ko": {
