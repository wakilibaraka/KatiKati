    "Off unless you turn it on: it reads window titles on this Mac and spends a little CPU to keep the AI chip current." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Standardmäßig aus: Eingeschaltet liest es Fenstertitel auf diesem Mac und verbraucht etwas CPU, damit der KI-Chip aktuell bleibt."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Off unless you turn it on: it reads window titles on this Mac and spends a little CPU to keep the AI chip current."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Desactivado por defecto: al activarlo lee los títulos de las ventanas de este Mac y consume algo de CPU para mantener al día el chip de IA."
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Desactivado por defecto: al activarlo lee los títulos de las ventanas de este Mac y consume algo de CPU para mantener al día el chip de IA."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Désactivé par défaut : activé, il lit les titres des fenêtres de ce Mac et consomme un peu de CPU pour garder la puce IA à jour."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Disattivato per impostazione predefinita: se attivo legge i titoli delle finestre di questo Mac e consuma un po' di CPU per tenere aggiornato il chip IA."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "既定ではオフ：オンにするとこの Mac のウインドウタイトルを読み取り、少しの CPU を使って AI チップを最新に保ちます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "기본값은 꺼짐: 켜면 이 Mac의 윈도우 제목을 읽고 약간의 CPU를 사용해 AI 칩을 최신으로 유지합니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Desativado por padrão: ao ativar, ele lê os títulos das janelas deste Mac e usa um pouco de CPU para manter o chip de IA atualizado."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Desativado por predefinição: ao ativar, lê os títulos das janelas deste Mac e usa um pouco de CPU para manter o chip de IA atualizado."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "默认关闭：开启后会读取此 Mac 上的窗口标题，并消耗少量 CPU 让 AI 芯片保持最新。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "預設關閉：開啟後會讀取此 Mac 上的視窗標題，並耗用少量 CPU 讓 AI 晶片保持最新。"
          }
        }
      }
    },
