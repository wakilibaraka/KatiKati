    "Match across Wallpaper, Lock Screen & Desktop" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Match across Wallpaper, Lock Screen & Desktop" } },
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "壁纸、锁屏与桌面保持一致" } },
        "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "桌布、鎖定畫面與桌面保持一致" } },
        "ja" : { "stringUnit" : { "state" : "translated", "value" : "壁紙・ロック画面・デスクトップで統一" } },
        "de" : { "stringUnit" : { "state" : "translated", "value" : "Auf Wallpaper, Sperrbildschirm & Schreibtisch abstimmen" } },
        "fr" : { "stringUnit" : { "state" : "translated", "value" : "Aligner fond d'écran, écran de verrouillage et bureau" } },
        "es" : { "stringUnit" : { "state" : "translated", "value" : "Igualar en fondo, pantalla de bloqueo y escritorio" } },
        "es-419" : { "stringUnit" : { "state" : "translated", "value" : "Igualar en fondo, pantalla de bloqueo y escritorio" } },
