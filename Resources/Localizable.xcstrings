    "The keyboard-targeted window takes the focus border; the window under the pointer takes the hover border." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Das per Tastatur gewählte Fenster erhält den Fokusrahmen, das Fenster unter dem Zeiger den Hover-Rahmen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The keyboard-targeted window takes the focus border; the window under the pointer takes the hover border."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La ventana elegida con el teclado recibe el borde de foco; la ventana bajo el puntero, el borde de puntero."
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La ventana elegida con el teclado recibe el borde de foco; la ventana bajo el puntero, el borde de puntero."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La fenêtre ciblée au clavier reçoit la bordure de focus ; celle sous le pointeur, la bordure de survol."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La finestra scelta da tastiera riceve il bordo del focus; quella sotto il puntatore il bordo hover."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "キーボードで選んだウインドウにフォーカス枠、ポインタ下のウインドウにホバー枠を表示します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "키보드로 선택한 윈도우에는 포커스 테두리, 포인터 아래 윈도우에는 호버 테두리가 표시됩니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A janela escolhida pelo teclado recebe a borda de foco; a janela sob o ponteiro, a borda de ponteiro."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A janela escolhida pelo teclado recebe o contorno de foco; a janela sob o ponteiro, o contorno de ponteiro."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "键盘选中的窗口使用焦点边框，指针下的窗口使用悬停边框。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "鍵盤選取的視窗使用焦點邊框，指標下的視窗使用懸停邊框。"
          }
        }
      }
    },
