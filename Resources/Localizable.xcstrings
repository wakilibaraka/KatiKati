            "value": "Dock ausblenden (automatisch ausblenden und am unteren Rand nicht wecken)"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Masquer le Dock (masquage automatique, sans réveil au bord inférieur)"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ocultar el Dock (ocultación automática, sin despertarlo en el borde inferior)"
          }
        },
        "es-419": {
