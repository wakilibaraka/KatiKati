    "Alerts fire when a level is crossed, not while it sits there.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Alerts fire when a level is crossed, not while it sits there."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "电量越过阈值时才提醒，停在阈值上不会重复提醒。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "電量越過門檻時才提醒，停在門檻上不會重複提醒。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "しきい値を超えたときに通知し、そのまま留まっている間は通知しません。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Hinweise kommen beim Überschreiten einer Schwelle, nicht solange sie gehalten wird."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les alertes se déclenchent au franchissement d’un seuil, pas tant qu’il est atteint."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los avisos saltan al cruzar un umbral, no mientras se mantiene."
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "Los avisos saltan al cruzar un umbral, no mientras se mantiene."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Os avisos disparam ao cruzar um limite, não enquanto ele é mantido."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Os avisos surgem ao cruzar um limite, não enquanto este se mantém."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Gli avvisi scattano al superamento di una soglia, non finché resta tale."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "임계값을 넘을 때만 알리고, 머무는 동안에는 알리지 않습니다."
          }
        }
      }
    },
