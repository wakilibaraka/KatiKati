    "A small glass orb over your windows; click it to open the launcher, drag it anywhere.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A small glass orb over your windows; click it to open the launcher, drag it anywhere."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "悬浮在窗口上方的小圆球：点击打开启动台，拖动可放到任意位置。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "懸浮在視窗上方的小圓球：點擊開啟啟動台，拖曳可放到任意位置。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ウィンドウの上に浮かぶ小さな球体。クリックでランチャーを開き、ドラッグで好きな場所に移動できます。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Eine kleine Glaskugel über deinen Fenstern: Klicken öffnet den Launcher, Ziehen verschiebt sie."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une petite sphère en verre au-dessus de vos fenêtres : cliquez pour ouvrir le lanceur, faites-la glisser où vous voulez."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Una pequeña esfera de cristal sobre tus ventanas: haz clic para abrir el lanzador y arrástrala donde quieras."
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "Una pequeña esfera de cristal sobre tus ventanas: haz clic para abrir el lanzador y arrástrala donde quieras."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Uma pequena esfera de vidro sobre as suas janelas: clique para abrir o launcher e arraste para onde quiser."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Uma pequena esfera de vidro sobre as suas janelas: clique para abrir o launcher e arraste para onde quiser."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Una piccola sfera di vetro sopra le tue finestre: fai clic per aprire il launcher e trascinala dove vuoi."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "창 위에 떠 있는 작은 유리 구슬입니다. 클릭하면 런처가 열리고, 끌어서 원하는 곳에 둘 수 있습니다."
          }
        }
      }
    },
    "Only for the voice recorder and the camera mirror. Nothing records until you start one.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Only for the voice recorder and the camera mirror. Nothing records until you start one."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "只用于录音机与摄像头镜像。你不开始录制，它就不会录音。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "只用於錄音機與相機鏡像。你不開始錄製，它就不會錄音。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ボイスレコーダーとカメラミラー専用です。録音を始めるまで何も記録しません。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nur für den Sprachrecorder und den Kameraspiegel. Aufgenommen wird erst, wenn du startest."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Uniquement pour l’enregistreur vocal et le miroir de la caméra. Rien n’est enregistré avant que vous ne démarriez."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Solo para la grabadora de voz y el espejo de cámara. No se graba nada hasta que empieces."
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "Solo para la grabadora de voz y el espejo de cámara. No se graba nada hasta que empieces."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Só para o gravador de voz e o espelho da câmera. Nada é gravado até você iniciar."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Só para o gravador de voz e o espelho da câmara. Nada é gravado até iniciar."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Solo per il registratore vocale e lo specchio della fotocamera. Nulla viene registrato finché non avvii."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
