    "To-Do: type a task and press Return, click the circle to finish it and the star to mark it important." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aufgaben: Aufgabe eintippen und Return drücken, Kreis anklicken zum Erledigen, Stern für wichtig."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "To-Do: type a task and press Return, click the circle to finish it and the star to mark it important."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tareas: escribe una tarea y pulsa Retorno; haz clic en el círculo para completarla y en la estrella para marcarla importante."
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tareas: escribe una tarea y pulsa Retorno; haz clic en el círculo para completarla y en la estrella para marcarla importante."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tâches : saisissez une tâche et appuyez sur Retour ; cliquez sur le cercle pour la terminer, sur l’étoile pour la marquer importante."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Attività: scrivi un’attività e premi Invio; clicca il cerchio per completarla e la stella per segnarla importante."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ToDo：タスクを入力して Return。丸をクリックで完了、星で重要マーク。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "할 일: 작업을 입력하고 Return을 누르세요. 원을 클릭하면 완료, 별을 클릭하면 중요 표시됩니다."
          }
        },
        "pt-BR" : {
