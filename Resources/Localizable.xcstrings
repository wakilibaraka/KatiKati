    "The colour wash behind Settings. It follows the time of day unless you pick a fixed time.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The colour wash behind Settings. It follows the time of day unless you pick a fixed time."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "设置背后的色彩光晕。除非选择固定时段，否则随一天的时间变化。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "設定背後的色彩光暈。除非選擇固定時段，否則會隨一天的時間變化。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "設定の背景に広がる色の光。時間帯を固定しない限り、時刻に合わせて変わります。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Der Farbschimmer hinter den Einstellungen. Er folgt der Tageszeit, sofern keine feste Zeit gewählt ist."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "La teinte en arrière-plan des Réglages. Elle suit l’heure du jour, sauf si vous choisissez un moment fixe."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "El tono de fondo de Ajustes. Sigue la hora del día salvo que elijas una hora fija."
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "needs_review",
            "value": "El tono de fondo de Ajustes. Sigue la hora del día salvo que elijas una hora fija."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "O tom de fundo dos Ajustes. Segue a hora do dia, a menos que você escolha um horário fixo."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "needs_review",
            "value": "O tom de fundo das Definições. Segue a hora do dia, a menos que escolha um horário fixo."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "La sfumatura dietro le Impostazioni. Segue l’ora del giorno, a meno che tu non scelga un orario fisso."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "설정 뒤의 색상 효과입니다. 고정 시간을 고르지 않으면 하루 시간에 따라 바뀝니다."
          }
        }
      }
    },
