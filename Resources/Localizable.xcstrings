    "Double-tap shortcuts need the Accessibility permission. ⌃Space may also switch input sources.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Double-tap shortcuts need the Accessibility permission. ⌃Space may also switch input sources."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "双击快捷键需要“辅助功能”权限。⌃Space 也可能用于切换输入法。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "連按兩下快速鍵需要「輔助使用」權限。⌃Space 也可能用於切換輸入方式。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ダブルタップのショートカットにはアクセシビリティの許可が必要です。⌃Space は入力ソースの切り替えにも使われることがあります。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Doppeltipp-Kürzel benötigen die Bedienungshilfen-Berechtigung. ⌃Space kann auch die Eingabequelle wechseln."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les raccourcis à double appui nécessitent l’autorisation Accessibilité. ⌃Espace peut aussi changer de source de saisie."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los atajos de doble toque necesitan el permiso de Accesibilidad. ⌃Espacio también puede cambiar la fuente de entrada."
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "Los atajos de doble toque necesitan el permiso de Accesibilidad. ⌃Espacio también puede cambiar la fuente de entrada."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Atalhos de toque duplo precisam da permissão de Acessibilidade. ⌃Espaço também pode trocar a fonte de entrada."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Os atalhos de toque duplo precisam da permissão de Acessibilidade. ⌃Espaço também pode mudar a fonte de entrada."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I comandi a doppio tocco richiedono il permesso Accessibilità. ⌃Spazio può anche cambiare la sorgente di input."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "두 번 탭 단축키에는 손쉬운 사용 권한이 필요합니다. ⌃Space는 입력 소스 전환에도 쓰일 수 있습니다."
          }
        }
      }
    },
