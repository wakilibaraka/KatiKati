          "stringUnit" : {
            "state" : "new",
            "value" : "この画面で開いているウインドウを重ならないように整列します。オフにすると、各ウインドウは元の位置に戻ります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "이 화면에서 열린 윈도우를 겹치지 않게 정렬합니다. 끄면 모든 윈도우가 원래 위치로 돌아갑니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Arranges your open windows on this screen without overlap. Turning it off puts every window back where it was."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Organiza as janelas abertas nesta tela sem sobreposição. Ao desativar, cada janela volta para onde estava."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Organiza as janelas abertas neste ecrã sem sobreposição. Ao desativar, cada janela regressa ao lugar onde estava."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Arranges your open windows on this screen without overlap. Turning it off puts every window back where it was."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "在此屏幕上无重叠地排列已打开的窗口。关闭后，每个窗口都会回到原来的位置。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "在此螢幕上不重疊地排列已開啟的視窗。關閉後，每個視窗都會回到原來的位置。"
          }
        }
      }
    },
