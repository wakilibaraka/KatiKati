    "Telemetry slows down while a full-screen app or Low Power Mode is active." : {
      "comment" : "System flyout · throttled badge help",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bei einer Vollbild-App oder im Energiesparmodus wird die Telemetrie langsamer aktualisiert."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Telemetry slows down while a full-screen app or Low Power Mode is active."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La telemetría se ralentiza con una app a pantalla completa o el modo de bajo consumo activo."
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La telemetría se ralentiza con una app a pantalla completa o el modo de bajo consumo activo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La télémétrie ralentit lorsqu'une app plein écran ou le mode économie d'énergie est actif."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La telemetria rallenta con un'app a schermo intero o la modalità risparmio energetico attiva."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "フルスクリーンアプリまたは低電力モード中はテレメトリの更新が遅くなります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "전체 화면 앱이나 저전력 모드가 켜져 있으면 원격 측정이 느려집니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A telemetria fica mais lenta com um app em tela cheia ou o modo de baixo consumo ativo."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A telemetria abranda com uma app em ecrã inteiro ou o modo de poupança de energia ativo."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
