    "Skip Hold" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Halten überspringen"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Skip Hold"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sin mantener"
          }
        },
        "es-419" : {
          "stringUnit" : {
