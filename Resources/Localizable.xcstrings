    "Three islands: launcher and weather, apps and now playing, clock and widgets.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Three islands: launcher and weather, apps and now playing, clock and widgets."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "三个岛：启动器与天气、应用与正在播放、时钟与小组件。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "三個島：啟動器與天氣、App 與正在播放、時鐘與小工具。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "3つのアイランド：ランチャーと天気、アプリと再生中、時計とウィジェット。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Drei Inseln: Launcher und Wetter, Apps und Wiedergabe, Uhr und Widgets."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Trois îlots : lanceur et météo, apps et lecture en cours, horloge et widgets."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tres islas: lanzador y tiempo, apps y reproduciendo, reloj y widgets."
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "Tres islas: lanzador y clima, apps y reproduciendo, reloj y widgets."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Três ilhas: iniciador e clima, apps e tocando agora, relógio e widgets."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Três ilhas: iniciador e tempo, apps e a reproduzir, relógio e widgets."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tre isole: launcher e meteo, app e in riproduzione, orologio e widget."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "세 개의 섬: 런처와 날씨, 앱과 지금 재생 중, 시계와 위젯."
          }
        }
      }
    },
