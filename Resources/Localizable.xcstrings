    "This backup was made by a newer version of KatiKati. Update KatiKati and try again.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This backup was made by a newer version of KatiKati. Update KatiKati and try again."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这个备份由更新版本的 KatiKati 创建。请更新 KatiKati 后重试。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "這個備份由較新版本的 KatiKati 建立。請更新 KatiKati 後再試一次。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このバックアップは新しいバージョンの KatiKati で作成されました。KatiKati をアップデートしてからもう一度お試しください。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieses Backup wurde mit einer neueren Version von KatiKati erstellt. Aktualisieren Sie KatiKati und versuchen Sie es erneut."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cette sauvegarde a été créée par une version plus récente de KatiKati. Mettez KatiKati à jour et réessayez."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta copia se hizo con una versión más reciente de KatiKati. Actualiza KatiKati e inténtalo de nuevo."
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "Este respaldo se hizo con una versión más reciente de KatiKati. Actualiza KatiKati e inténtalo de nuevo."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Este backup foi criado por uma versão mais recente do KatiKati. Atualize o KatiKati e tente novamente."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta cópia foi criada por uma versão mais recente do KatiKati. Atualize o KatiKati e tente novamente."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questo backup è stato creato da una versione più recente di KatiKati. Aggiorna KatiKati e riprova."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 백업은 더 최신 버전의 KatiKati에서 만들어졌습니다. KatiKati를 업데이트한 후 다시 시도하세요."
          }
        }
      }
    },
