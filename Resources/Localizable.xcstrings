    "Applies to the trash and the menu bar icon. Independent of the theme.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Applies to the trash and the menu bar icon. Independent of the theme."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "应用于废纸篓和菜单栏图标，与主题互不影响。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "套用於垃圾桶和選單列圖示，與主題互不影響。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ゴミ箱とメニューバーのアイコンに適用されます。テーマとは独立しています。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Gilt für den Papierkorb und das Menüleistensymbol. Unabhängig vom Design."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "S’applique à la corbeille et à l’icône de la barre des menus. Indépendant du thème."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se aplica a la papelera y al icono de la barra de menús. Independiente del tema."
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "Se aplica a la papelera y al ícono de la barra de menús. Independiente del tema."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Aplica-se ao lixo e ao ícone da barra de menus. Independente do tema."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Aplica-se ao lixo e ao ícone da barra de menus. Independente do tema."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Si applica al cestino e all’icona della barra dei menu. Indipendente dal tema."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "휴지통과 메뉴 막대 아이콘에 적용됩니다. 테마와는 별개입니다."
          }
        }
      }
    },
