    "Instance presets, spacing, dynamic resizing, app groups, and hover feedback." : {
      "localizations" : {
        "de" : { "stringUnit" : { "state" : "translated", "value" : "Instanz-Vorgaben, Abstände, dynamische Größe, App-Gruppen und Hover-Feedback." } },
