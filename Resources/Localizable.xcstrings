    "Some items can’t be accessed. Allow KatiKati to access their folder in your Mac’s privacy settings.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "有项目暂时无法访问。请在系统隐私设置里允许KatiKati访问它们所在的文件夹。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Some items can’t be accessed. Allow KatiKati to access their folder in your Mac’s privacy settings."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "有些項目無法取用。請在Mac的隱私權設定裡允許KatiKati取用它們所在的檔案夾。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "一部の項目にアクセスできません。Macのプライバシー設定で、それらの項目があるフォルダへのKatiKatiのアクセスを許可してください。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Auf einige Objekte kann nicht zugegriffen werden. Erlaube KatiKati in den Datenschutzeinstellungen deines Macs den Zugriff auf den betreffenden Ordner."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Certains éléments sont inaccessibles. Autorisez KatiKati à accéder à leur dossier dans les réglages de confidentialité de votre Mac."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se puede acceder a algunos ítems. Permite que KatiKati acceda a su carpeta en los ajustes de privacidad de tu Mac."
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "No se puede acceder a algunos elementos. Permite que KatiKati acceda a su carpeta en la configuración de privacidad de tu Mac."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não é possível acessar alguns itens. Permita que o KatiKati acesse a pasta deles nos ajustes de privacidade do seu Mac."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Não é possível aceder a alguns elementos. Permita que o KatiKati aceda à pasta destes nas definições de privacidade do seu Mac."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Alcuni elementi non sono accessibili. Consenti a KatiKati di accedere alla loro cartella nelle impostazioni della privacy del Mac."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "일부 항목에 접근할 수 없습니다. Mac의 개인정보 보호 설정에서 KatiKati가 해당 폴더에 접근하도록 허용하십시오."
          }
        }
      }
    },
