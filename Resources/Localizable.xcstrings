    "Accessibility is off, so banners stay where macOS puts them. Grant it in Privacy & Security, then turn the switch back on." : {
      "localizations" : {
        "de" : { "stringUnit" : { "state" : "translated", "value" : "Bedienungshilfen sind aus, Banner bleiben also dort, wo macOS sie hinstellt. Erlaube sie in „Datenschutz & Sicherheit“ und schalte den Schalter danach wieder ein." } },
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Accessibility is off, so banners stay where macOS puts them. Grant it in Privacy & Security, then turn the switch back on." } },
        "es" : { "stringUnit" : { "state" : "translated", "value" : "La accesibilidad está desactivada, así que los avisos se quedan donde macOS los coloca. Actívala en Privacidad y seguridad y vuelve a encender el interruptor." } },
        "es-419" : { "stringUnit" : { "state" : "translated", "value" : "La accesibilidad está desactivada, así que los avisos se quedan donde macOS los coloca. Actívala en Privacidad y seguridad y vuelve a encender el interruptor." } },
        "fr" : { "stringUnit" : { "state" : "translated", "value" : "L’accessibilité est désactivée : les bannières restent là où macOS les place. Autorisez-la dans Confidentialité et sécurité, puis réactivez l’interrupteur." } },
        "it" : { "stringUnit" : { "state" : "translated", "value" : "L’accessibilità è disattivata, quindi i banner restano dove li mette macOS. Concedila in Privacy e sicurezza, poi riattiva l’interruttore." } },
        "ja" : { "stringUnit" : { "state" : "translated", "value" : "アクセシビリティがオフのため、通知バナーはmacOSが置いた場所に残ります。「プライバシーとセキュリティ」で許可してから、スイッチを入れ直してください。" } },
        "ko" : { "stringUnit" : { "state" : "translated", "value" : "손쉬운 사용이 꺼져 있어 알림 배너는 macOS가 배치한 곳에 그대로 남습니다. ‘개인정보 보호 및 보안’에서 허용한 뒤 스위치를 다시 켜세요." } },
        "pt-BR" : { "stringUnit" : { "state" : "translated", "value" : "A Acessibilidade está desligada, então os avisos ficam onde o macOS os coloca. Conceda-a em Privacidade e Segurança e ligue o interruptor de novo." } },
        "pt-PT" : { "stringUnit" : { "state" : "translated", "value" : "A Acessibilidade está desativada, por isso os avisos ficam onde o macOS os coloca. Conceda-a em Privacidade e Segurança e volte a ligar o interruptor." } },
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "辅助功能未开启，通知横幅会留在 macOS 安排的位置。请在“隐私与安全性”中授权，然后重新打开开关。" } },
        "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "輔助使用未開啟，通知橫幅會留在 macOS 安排的位置。請在「隱私權與安全性」中授權，然後重新開啟開關。" } }
      }
    },
