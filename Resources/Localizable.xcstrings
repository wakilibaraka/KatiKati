    "Your message or attachments were not accepted. Try shortening the message or using a different file, or email support@katikati.app.": {
      "comment": "反馈失败 · 内容或附件被服务端拒绝",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "内容或附件没被接受。试着精简内容或换一个附件，或发邮件到 support@katikati.app。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your message or attachments were not accepted. Try shortening the message or using a different file, or email support@katikati.app."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "你的內容或附件沒有被接受。試著精簡內容或換一個檔案，或寄信到support@katikati.app。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "入力した内容または添付ファイルが受け付けられませんでした。内容を短くするか、別のファイルでお試しください。support@katikati.appまでメールでご連絡いただくこともできます。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dein Text oder deine Anhänge wurden nicht angenommen. Kürze den Text oder nimm eine andere Datei – oder schreib eine E-Mail an support@katikati.app."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Votre message ou vos pièces jointes ont été refusés. Essayez de raccourcir le message ou de changer de fichier, ou écrivez à support@katikati.app."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se han aceptado tu mensaje o tus adjuntos. Prueba a acortar el mensaje o a usar otro archivo, o envía un correo a support@katikati.app."
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "No se aceptaron tu mensaje o tus adjuntos. Intenta acortar el mensaje o usar otro archivo, o envía un correo a support@katikati.app."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Sua mensagem ou seus anexos não foram aceitos. Tente encurtar a mensagem ou usar outro arquivo, ou envie um e-mail para support@katikati.app."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "A sua mensagem ou os seus anexos não foram aceites. Experimente encurtar a mensagem ou usar outro ficheiro, ou envie um e-mail para support@katikati.app."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il messaggio o gli allegati non sono stati accettati. Prova ad accorciare il messaggio o a usare un altro file, oppure scrivi a support@katikati.app."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "메시지 또는 첨부 파일이 받아들여지지 않았습니다. 메시지를 줄이거나 다른 파일을 사용해 보거나, support@katikati.app 주소로 이메일을 보내십시오."
          }
        }
      }
    },
    "You’re Already Subscribed": {
