    "Floating keeps the bar 8 pt above the screen edge. Hugging sits it almost on the edge.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Floating keeps the bar 8 pt above the screen edge. Hugging sits it almost on the edge."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "浮动：任务栏离屏幕底边 8 pt。贴边：几乎贴在底边上。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "浮動：工作列離螢幕底邊 8 pt。貼邊：幾乎貼在底邊上。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "フローティングは画面端から 8 pt 上に表示し、密着はほぼ端に配置します。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Schwebend hält die Leiste 8 pt über dem Bildschirmrand. Anliegend setzt sie fast direkt auf den Rand."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Flottante garde la barre à 8 pt du bord de l’écran. Collée la place presque sur le bord."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Flotante deja la barra 8 pt por encima del borde. Pegada la coloca casi sobre el borde."
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "Flotante deja la barra 8 pt por encima del borde. Pegada la coloca casi sobre el borde."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Flutuante mantém a barra 8 pt acima da borda. Encostada a deixa quase na borda."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Flutuante mantém a barra 8 pt acima da margem. Encostada coloca-a quase na margem."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Fluttuante tiene la barra 8 pt sopra il bordo. Aderente la posa quasi sul bordo."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "떠 있음은 막대를 화면 가장자리에서 8pt 위에 두고, 붙임은 거의 가장자리에 둡니다."
          }
        }
      }
    },
