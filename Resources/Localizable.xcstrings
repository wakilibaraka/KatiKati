        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ピン留めした項目は期限切れになりません。履歴はメモリ内にのみ保持されます。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
