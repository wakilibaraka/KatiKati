    "Space names appear once a display layout is readable. Each name is stored against the Space's own ID, so it survives a restart and reordering." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Space-Namen erscheinen, sobald ein Display-Layout lesbar ist. Jeder Name hängt an der eigenen ID des Spaces und übersteht Neustart und Umsortieren."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Space names appear once a display layout is readable. Each name is stored against the Space's own ID, so it survives a restart and reordering."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los nombres de Space aparecen cuando se puede leer la disposición de una pantalla. Cada nombre se guarda con el ID propio del Space, así que sobrevive a reinicios y reordenaciones."
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los nombres de Space aparecen cuando se puede leer la disposición de una pantalla. Cada nombre se guarda con el ID propio del Space, así que sobrevive a reinicios y reordenaciones."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les noms d’espace apparaissent dès qu’une disposition d’écran est lisible. Chaque nom est lié à l’ID propre de l’espace : il survit au redémarrage et à la réorganisation."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I nomi degli Space compaiono quando il layout di un display è leggibile. Ogni nome è legato all’ID dello Space, quindi sopravvive a riavvii e riordini."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "画面レイアウトを読み取れるとスペース名が表示されます。名前はスペース固有の ID に保存されるため、再起動や並べ替えでも保持されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "디스플레이 레이아웃을 읽을 수 있으면 Space 이름이 나타납니다. 이름은 Space 고유 ID에 저장되어 재시동과 순서 변경에도 유지됩니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Os nomes de Space aparecem quando o layout de uma tela é legível. Cada nome fica no ID próprio do Space, sobrevivendo a reinícios e reordenações."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Os nomes de Space aparecem quando o layout de um ecrã é legível. Cada nome fica no ID próprio do Space, sobrevivendo a reinícios e reordenações."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "当一个显示器的布局可读取时会显示 Space 名称。每个名称都绑定到 Space 自身的 ID，因此重启和重新排序后依然保留。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "當一個顯示器的佈局可讀取時會顯示 Space 名稱。每個名稱都綁定到 Space 自身的 ID，因此重啟和重新排序後依然保留。"
          }
        }
      }
    },
