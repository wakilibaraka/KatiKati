    "Vinyl Music: a spinning record for what is playing, with play, pause and skip." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vinyl Music: eine drehende Schallplatte für den laufenden Titel, mit Wiedergabe, Pause und Überspringen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vinyl Music: a spinning record for what is playing, with play, pause and skip."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vinyl Music: un disco que gira con lo que suena, con reproducir, pausar y saltar."
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vinyl Music: un disco que gira con lo que suena, con reproducir, pausar y saltar."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vinyl Music : un disque qui tourne pour le titre en cours, avec lecture, pause et saut."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vinyl Music: un disco che gira per ciò che è in riproduzione, con play, pausa e salto."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "バイナルミュージック：再生中の曲を回るレコードで表示。再生、一時停止、スキップに対応。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "바이닐 뮤직: 재생 중인 곡을 회전하는 레코드로 보여주며 재생, 일시 정지, 건너뛰기를 지원합니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vinyl Music: um disco girando para o que está tocando, com reproduzir, pausar e pular."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vinyl Music: um disco girando para o que está tocando, com reproduzir, pausar e pular."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "黑胶音乐：用旋转的唱片显示正在播放的内容，可播放、暂停和切歌。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "黑膠音樂：以旋轉的唱片顯示正在播放的內容，可播放、暫停和切歌。"
          }
        }
      }
    },
