    "Pinned entries stay; everything else is forgotten. History is never saved to disk.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Pinned entries stay; everything else is forgotten. History is never saved to disk."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "固定项会保留，其余内容会被忘记。历史记录从不写入磁盘。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "固定項目會保留，其餘內容會被忘記。歷史記錄從不寫入磁碟。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ピン留めした項目は残り、それ以外は忘れられます。履歴はディスクに保存されません。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Angeheftete Einträge bleiben, alles andere wird vergessen. Der Verlauf wird nie auf der Festplatte gespeichert."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les éléments épinglés restent ; le reste est oublié. L’historique n’est jamais enregistré sur le disque."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los elementos fijados se quedan; el resto se olvida. El historial nunca se guarda en el disco."
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "Los elementos fijados se quedan; el resto se olvida. El historial nunca se guarda en el disco."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Itens fixados ficam; o resto é esquecido. O histórico nunca é salvo no disco."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Itens fixados ficam; o resto é esquecido. O histórico nunca é guardado no disco."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Gli elementi fissati restano; il resto viene dimenticato. La cronologia non viene mai salvata su disco."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "고정된 항목은 남고 나머지는 사라집니다. 기록은 디스크에 저장되지 않습니다."
          }
        }
      }
    },
    "Clear Unpinned Shelf Items?": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
