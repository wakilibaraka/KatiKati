    "Turn on KatiKati in %@. This window closes by itself once you do, and the taskbar finishes starting.": {
      "comment": "%@ 是系统设置里的权限路径，随 macOS 版本不同",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请在%@中，打开 KatiKati的开关。开启后本窗口会自动关闭，Dock 栏会继续启动。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Turn on KatiKati in %@. This window closes by itself once you do, and the taskbar finishes starting."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "請在%@中打開KatiKati的開關。打開後這個視窗會自動關閉，工作列也會繼續啟動。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@でKatiKatiをオンにしてください。オンにするとこのウインドウは自動的に閉じ、タスクバーの起動が完了します。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Aktiviere KatiKati unter %@. Sobald du das getan hast, schließt sich dieses Fenster von selbst und die Taskleiste startet vollständig."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Activez KatiKati dans %@. Cette fenêtre se ferme alors d’elle-même et la barre des tâches termine son démarrage."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Activa KatiKati en %@. Esta ventana se cerrará sola cuando lo hagas y la barra de tareas terminará de iniciarse."
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "Activa KatiKati en %@. Esta ventana se cerrará automáticamente cuando lo hagas y la barra de tareas terminará de iniciarse."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Ative o KatiKati em %@. Esta janela se fecha sozinha quando você fizer isso, e a barra de tarefas termina de iniciar."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
