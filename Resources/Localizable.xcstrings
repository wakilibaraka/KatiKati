    "Right-click a window chip for a floating jump list above the dock. Turn this on to use the system menu instead.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Right-click a window chip for a floating jump list above the dock. Turn this on to use the system menu instead."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "右键点击窗口卡片会在程序坞上方弹出浮动列表。开启此项则改用系统菜单。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在視窗卡片上按右鍵會在 Dock 上方彈出浮動列表。開啟此項則改用系統選單。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ウインドウチップを右クリックすると、Dockの上にジャンプリストが表示されます。オンにするとシステムメニューを使います。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Rechtsklick auf einen Fenster-Chip öffnet eine schwebende Liste über dem Dock. Aktivieren, um stattdessen das Systemmenü zu verwenden."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un clic droit sur une pastille ouvre une liste flottante au-dessus du Dock. Activez cette option pour utiliser le menu système."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Haz clic derecho en una ficha de ventana para ver una lista flotante sobre el Dock. Actívalo para usar el menú del sistema."
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "Haz clic derecho en una ficha de ventana para ver una lista flotante sobre el Dock. Actívalo para usar el menú del sistema."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Clique com o botão direito num chip de janela para ver uma lista flutuante acima do Dock. Ative para usar o menu do sistema."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Clique com o botão direito num chip de janela para ver uma lista flutuante acima do Dock. Ative para usar o menu do sistema."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Fai clic destro su un chip finestra per una lista flottante sopra il Dock. Attiva per usare il menu di sistema."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "창 칩을 오른쪽 클릭하면 Dock 위에 떠 있는 목록이 나타납니다. 켜면 시스템 메뉴를 사용합니다."
          }
        }
      }
    },
    "Window previews need Screen Recording permission. Without it, previews show titles only.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Window previews need Screen Recording permission. Without it, previews show titles only."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "窗口预览需要“屏幕录制”权限；没有权限时只显示标题。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "視窗預覽需要「螢幕錄製」權限；沒有權限時只顯示標題。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ウインドウのプレビューには画面収録の許可が必要です。許可がない場合はタイトルのみ表示されます。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Fenstervorschauen benötigen die Bildschirmaufnahme-Berechtigung. Ohne sie werden nur Titel angezeigt."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les aperçus de fenêtres nécessitent l’autorisation d’enregistrement de l’écran. Sans elle, seuls les titres s’affichent."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las vistas previas de ventanas necesitan permiso de grabación de pantalla. Sin él, solo se muestran los títulos."
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "Las vistas previas de ventanas necesitan permiso de grabación de pantalla. Sin él, solo se muestran los títulos."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "As pré-visualizações de janelas precisam da permissão de Gravação de Ecrã. Sem ela, só aparecem os títulos."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "As pré-visualizações de janelas precisam da permissão de Gravação de Ecrã. Sem ela, só aparecem os títulos."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le anteprime delle finestre richiedono l’autorizzazione Registrazione schermo. Senza, vengono mostrati solo i titoli."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "창 미리보기에는 화면 기록 권한이 필요합니다. 권한이 없으면 제목만 표시됩니다."
          }
        }
      }
    },
