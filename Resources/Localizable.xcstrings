    "A small CPU and memory readout in the menu bar. Click it to open Activity Monitor.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A small CPU and memory readout in the menu bar. Click it to open Activity Monitor."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在菜单栏显示精简的 CPU 和内存读数。点按即可打开“活动监视器”。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在選單列顯示精簡的 CPU 和記憶體讀數。點按即可打開「活動監視器」。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "メニューバーにCPUとメモリの小さな表示を出します。クリックするとアクティビティモニタが開きます。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Eine kleine CPU- und Speicheranzeige in der Menüleiste. Ein Klick öffnet die Aktivitätsanzeige."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un petit relevé du CPU et de la mémoire dans la barre des menus. Cliquez dessus pour ouvrir Moniteur d’activité."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Una pequeña lectura de CPU y memoria en la barra de menús. Haz clic para abrir Monitor de Actividad."
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "Una pequeña lectura de CPU y memoria en la barra de menús. Haz clic para abrir el Monitor de Actividad."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
