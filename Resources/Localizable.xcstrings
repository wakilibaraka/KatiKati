        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Metà dello schermo: copertina, titolo, barra di avanzamento e controlli. Sopra le icone, sotto ogni finestra di app."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "画面の半分にアート、タイトル、シークバー、再生コントロール。アイコンの上、すべての App ウインドウの下に表示します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
