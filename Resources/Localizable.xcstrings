    "Type a snippet's trigger in any app to paste its text. Supports {clipboard}, {date}, {time}, and {cursor}. Never runs in password fields." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Den Auslöser eines Snippets in einer beliebigen App tippen, um den Text einzufügen. Unterstützt {clipboard}, {date}, {time} und {cursor}. Läuft nie in Passwortfeldern."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Type a snippet's trigger in any app to paste its text. Supports {clipboard}, {date}, {time}, and {cursor}. Never runs in password fields."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Escribe el activador de un fragmento en cualquier app para pegar su texto. Admite {clipboard}, {date}, {time} y {cursor}. Nunca se ejecuta en campos de contraseña."
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Escribe el activador de un fragmento en cualquier app para pegar su texto. Admite {clipboard}, {date}, {time} y {cursor}. Nunca se ejecuta en campos de contraseña."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tapez le déclencheur d'un extrait dans n'importe quelle app pour coller son texte. Prend en charge {clipboard}, {date}, {time} et {cursor}. Ne s'exécute jamais dans un champ de mot de passe."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Digita il trigger di un frammento in qualsiasi app per incollarne il testo. Supporta {clipboard}, {date}, {time} e {cursor}. Non si attiva mai nei campi password."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "どのアプリでもスニペットのトリガーを入力すると本文をペーストします。{clipboard}、{date}、{time}、{cursor} に対応。パスワード欄では動作しません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "어떤 앱에서든 스니펫 트리거를 입력하면 텍스트가 붙여넣어집니다. {clipboard}, {date}, {time}, {cursor}를 지원합니다. 암호 입력란에서는 실행되지 않습니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Digite o gatilho de um trecho em qualquer app para colar o texto. Suporta {clipboard}, {date}, {time} e {cursor}. Nunca é executado em campos de senha."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Escreva o acionador de um excerto em qualquer app para colar o texto. Suporta {clipboard}, {date}, {time} e {cursor}. Nunca é executado em campos de palavra-passe."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在任意应用中输入片段的触发词即可粘贴其文本。支持 {clipboard}、{date}、{time} 和 {cursor}。从不在密码栏中运行。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在任一 App 中輸入片段的觸發詞即可貼上其文字。支援 {clipboard}、{date}、{time} 和 {cursor}。絕不在密碼欄位中執行。"
          }
        }
      }
    },
