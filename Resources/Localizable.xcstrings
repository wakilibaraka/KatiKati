    "Uses System Events automation to resize non-standard or Electron application windows when direct Accessibility fails.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Uses System Events automation to resize non-standard or Electron application windows when direct Accessibility fails."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "当常规辅助功能失效时，通过 System Events 脚本缩放非标准或 Electron 架构的应用窗口。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "當常規輔助功能失效時，透過 System Events 指令碼縮放非標準或 Electron 架構的應用視窗。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "通常のアクセシビリティAPIで失敗した場合、System Events 自動化を用いて Electron 等の非標準ウィンドウを縮小します。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Verwendet System Events, um nicht-standardmäßige oder Electron-Fenster anzupassen, falls Accessibility fehlschlägt."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Utilise l'automatisation System Events pour redimensionner les fenêtres Electron ou atypiques en cas d'échec d'accessibilité."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Usa la automatización de System Events para ajustar ventanas de Electron o no estándar cuando falla la accesibilidad directa."
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "Usa la automatización de System Events para ajustar ventanas de Electron o no estándar cuando falla la accesibilidad directa."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Usa automação do System Events para redimensionar janelas Electron ou não padronizadas quando a Acessibilidade falha."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Usa automação do System Events para redimensionar janelas Electron ou não padronizadas quando a Acessibilidade falha."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Usa l'automazione di System Events per ridimensionare finestre Electron o non standard se l'Accessibilità fallisce."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "직접적인 손쉬운 사용 제어가 실패할 경우 System Events 자동화를 사용하여 Electron 등 비표준 창의 크기를 조절합니다."
          }
        }
      }
    },
