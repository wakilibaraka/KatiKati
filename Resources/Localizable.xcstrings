    "While paused, key presses are ignored (the mouse still works). Press ⌃⌥⌘P to unpause. Needs the Input Monitoring permission." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Im angehaltenen Zustand werden Tastatureingaben ignoriert (die Maus funktioniert weiter). ⌃⌥⌘P setzt die Eingabe fort. Erfordert die Berechtigung „Eingabeüberwachung“."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "While paused, key presses are ignored (the mouse still works). Press ⌃⌥⌘P to unpause. Needs the Input Monitoring permission."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "En pausa, las pulsaciones se ignoran (el ratón sigue funcionando). Pulsa ⌃⌥⌘P para reanudar. Requiere el permiso de monitorización de entrada."
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "En pausa, las pulsaciones se ignoran (el ratón sigue funcionando). Presiona ⌃⌥⌘P para reanudar. Requiere el permiso de monitoreo de entrada."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "En pause, les frappes sont ignorées (la souris fonctionne toujours). Appuyez sur ⌃⌥⌘P pour reprendre. Nécessite l’autorisation de surveillance des saisies."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "In pausa, i tasti vengono ignorati (il mouse funziona sempre). Premi ⌃⌥⌘P per riprendere. Richiede il permesso di monitoraggio degli input."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "一時停止中はキー入力が無視されます（マウスは動作します）。⌃⌥⌘P で解除できます。入力監視の許可が必要です。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "일시 중지 중에는 키 입력이 무시됩니다(마우스는 계속 작동). ⌃⌥⌘P를 눌러 재개합니다. 입력 모니터링 권한이 필요합니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Em pausa, as teclas são ignoradas (o mouse continua funcionando). Pressione ⌃⌥⌘P para retomar. Requer a permissão de Monitoramento de Entrada."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Em pausa, as teclas são ignoradas (o rato continua a funcionar). Prima ⌃⌥⌘P para retomar. Requer a permissão de Monitorização de Entrada."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "暂停期间按键无效（鼠标仍可用）。按 ⌃⌥⌘P 恢复。需要“输入监控”权限。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "暫停期間按鍵無效（滑鼠仍可用）。按 ⌃⌥⌘P 恢復。需要「輸入監控」權限。"
          }
        }
      }
    },
    "While the pointer is over the dock, holding Control shows how much memory each app uses." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Halten Sie Control, während der Zeiger über dem Dock ist, um den Speicherverbrauch jeder App zu sehen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "While the pointer is over the dock, holding Control shows how much memory each app uses."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Con el puntero sobre el Dock, mantén Control para ver cuánta memoria usa cada app."
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Con el puntero sobre el Dock, mantén Control para ver cuánta memoria usa cada app."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quand le pointeur est sur le Dock, maintenez Contrôle pour voir la mémoire utilisée par chaque app."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Con il puntatore sul Dock, tieni premuto Control per vedere la memoria usata da ogni app."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ポインタがDock上にあるときControlを押すと、各アプリのメモリ使用量を表示します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "포인터가 Dock 위에 있을 때 Control을 누르면 각 앱의 메모리 사용량이 표시됩니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Com o ponteiro sobre o Dock, segure Control para ver quanta memória cada app usa."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Com o ponteiro sobre o Dock, mantenha Control para ver quanta memória cada app usa."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "指针在程序坞上时，按住 Control 会显示每个应用占用的内存。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "指標在 Dock 上時，按住 Control 會顯示每個 App 佔用的記憶體。"
          }
        }
      }
    },
