    "Putting the windows it moved back where they were.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "正在把之前让开过的窗口放回原位。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Putting the windows it moved back where they were."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "正在把先前挪開過的視窗放回原位。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "避けていたウインドウを元の位置に戻しています。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die zuvor verschobenen Fenster werden an ihre alte Position zurückgesetzt."
          }
        },
        "fr": {
