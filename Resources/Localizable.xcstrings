          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "new",
            "value": "New windows join the layout by themselves. Drag or resize a window and it is left alone until you press Re-tile. Apps in the floating list are never tiled. Full-screen windows are left alone, and windows that would end up too small stay as they are."
          }
        }
      }
    },
