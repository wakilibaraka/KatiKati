    "Gives every running app a chip, even when it has no open window — like the system Dock.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Gives every running app a chip, even when it has no open window — like the system Dock."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "即使没有打开的窗口，每个运行中的 App 也会有一张卡片，和系统 Dock 一样。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "即使沒有開啟的視窗，每個執行中的 App 也會有一張卡片，和系統 Dock 一樣。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "開いているウインドウがなくても、実行中のすべてのアプリにチップを表示します（システムのDockと同様）。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Gibt jeder laufenden App einen Chip, auch ohne geöffnetes Fenster – wie das System-Dock."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Donne une pastille à chaque app ouverte, même sans fenêtre, comme le Dock système."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Da una ficha a cada app en ejecución, incluso sin ventana abierta, como el Dock del sistema."
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "Da una ficha a cada app en ejecución, incluso sin ventana abierta, como el Dock del sistema."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Dá um chip a cada app em execução, mesmo sem janela aberta, como o Dock do sistema."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Dá um chip a cada app em execução, mesmo sem janela aberta, como o Dock do sistema."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Assegna un chip a ogni app in esecuzione, anche senza finestre aperte, come il Dock di sistema."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "열린 창이 없어도 실행 중인 모든 앱에 칩을 표시합니다. 시스템 Dock처럼 동작합니다."
          }
        }
      }
    },
