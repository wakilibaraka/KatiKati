    "Hyper turns Caps Lock into ⌃⌥⇧⌘. It listens to keyboard events only, needs the Input Monitoring permission, and Caps Lock is restored when you turn it off or quit.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Hyper turns Caps Lock into ⌃⌥⇧⌘. It listens to keyboard events only, needs the Input Monitoring permission, and Caps Lock is restored when you turn it off or quit."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Hyper 会把大写锁定键变成 ⌃⌥⇧⌘。它只监听键盘事件，需要“输入监控”权限；关闭或退出时会还原大写锁定键。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Hyper 會把大寫鎖定鍵變成 ⌃⌥⇧⌘。它只監聽鍵盤事件，需要「輸入監控」權限；關閉或結束時會還原大寫鎖定鍵。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "HyperはCaps Lockを⌃⌥⇧⌘に変えます。キーボードイベントのみを監視し、入力監視の許可が必要です。オフにするか終了するとCaps Lockは元に戻ります。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Hyper macht die Feststelltaste zu ⌃⌥⇧⌘. Es werden nur Tastaturereignisse überwacht; die Berechtigung „Eingabeüberwachung“ ist nötig. Beim Ausschalten oder Beenden wird die Feststelltaste wiederhergestellt."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Hyper transforme Verr. Maj en ⌃⌥⇧⌘. Seuls les événements clavier sont écoutés, l’autorisation Surveillance de l’entrée est requise, et Verr. Maj est restaurée à la désactivation ou à la fermeture."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Hyper convierte Bloq Mayús en ⌃⌥⇧⌘. Solo escucha eventos de teclado, requiere el permiso de Supervisión de entrada y Bloq Mayús se restaura al desactivarlo o salir."
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "Hyper convierte Bloq Mayús en ⌃⌥⇧⌘. Solo escucha eventos de teclado, requiere el permiso de Monitoreo de entrada y Bloq Mayús se restaura al desactivarlo o salir."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O Hyper transforma o Caps Lock em ⌃⌥⇧⌘. Só escuta eventos de teclado, precisa da permissão de Monitorização de Entrada e o Caps Lock é restaurado ao desativar ou sair."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "O Hyper transforma o Caps Lock em ⌃⌥⇧⌘. Só escuta eventos de teclado, precisa da permissão de Monitorização de Entrada e o Caps Lock é restaurado ao desativar ou sair."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Hyper trasforma Blocco Maiusc in ⌃⌥⇧⌘. Ascolta solo gli eventi della tastiera, richiede l’autorizzazione Monitoraggio input e Blocco Maiusc viene ripristinato quando lo disattivi o esci."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Hyper는 Caps Lock을 ⌃⌥⇧⌘로 바꿉니다. 키보드 이벤트만 감시하며 입력 모니터링 권한이 필요하고, 끄거나 종료하면 Caps Lock이 복원됩니다."
          }
        }
      }
    },
