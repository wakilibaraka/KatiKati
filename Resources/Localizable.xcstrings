    "Dock settings can’t be changed directly from a sandboxed environment.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "沙箱环境不能直接修改系统 Dock 设置。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Dock settings can’t be changed directly from a sandboxed environment."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "沙盒環境無法直接更改Dock設定。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "サンドボックス環境からDock設定を直接変更することはできません。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Aus einer Sandbox-Umgebung lassen sich die Dock-Einstellungen nicht direkt ändern."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les réglages du Dock ne peuvent pas être modifiés directement depuis un environnement en bac à sable."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los ajustes del Dock no se pueden cambiar directamente desde un entorno aislado (sandbox)."
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "La configuración del Dock no se puede cambiar directamente desde un entorno aislado (sandbox)."
