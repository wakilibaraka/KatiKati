    "%d items, %@. They are moved to the Trash, so you can put them back; apps rebuild them as needed.\n\n%@": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%d items, %@. They are moved to the Trash, so you can put them back; apps rebuild them as needed.\n\n%@"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%d 项，%@。它们会被移到废纸篓，可随时放回；应用会按需重建。\n\n%@"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "%d 項，%@。它們會被移到垃圾桶，可隨時放回；App 會視需要重建。\n\n%@"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%d 件、%@。ゴミ箱に移動するので元に戻せます。アプリが必要に応じて再作成します。\n\n%@"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%d Objekte, %@. Sie werden in den Papierkorb gelegt und können zurückgeholt werden; Apps bauen sie bei Bedarf neu auf.\n\n%@"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%d éléments, %@. Ils sont déplacés vers la corbeille, d’où vous pouvez les remettre ; les apps les recréent au besoin.\n\n%@"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%d elementos, %@. Se mueven a la papelera, así que puedes recuperarlos; las apps los reconstruyen cuando hace falta.\n\n%@"
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "%d elementos, %@. Se mueven a la papelera, así que puedes recuperarlos; las apps los reconstruyen cuando hace falta.\n\n%@"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "%d itens, %@. Eles vão para o Lixo, então você pode recuperá-los; os apps os recriam quando necessário.\n\n%@"
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "%d itens, %@. São movidos para o Lixo, pelo que pode restaurá-los; as apps recriam-nos quando necessário.\n\n%@"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "%d elementi, %@. Vengono spostati nel Cestino, quindi puoi recuperarli; le app li ricreano quando serve.\n\n%@"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%d개 항목, %@. 휴지통으로 이동하므로 다시 되돌릴 수 있으며, 앱이 필요할 때 다시 만듭니다.\n\n%@"
          }
        }
      }
    },
