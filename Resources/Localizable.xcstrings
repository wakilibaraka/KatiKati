    "Summons a circular pie menu at your cursor for lightning-fast window snapping, app launching, and quick actions with spring physics.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "Summons a circular pie menu at your cursor for lightning-fast window snapping, app launching, and quick actions with spring physics."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يستدعي قائمة دائرية عند المؤشر لمحاذاة النوافذ بسرعة فائقة وتشغيل التطبيقات والإجراءات السريعة بفيزياء النوابض."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ruft ein kreisförmiges Tortenmenü an Ihrem Cursor auf für blitzschnelles Einrasten von Fenstern, App-Starts und Schnellaktionen mit Federphysik."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Invoca un menú circular en el cursor para ajustar ventanas al instante, abrir apps y acciones rápidas con física de resorte."
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "Invoca un menú circular en el cursor para ajustar ventanas al instante, abrir apps y acciones rápidas con física de resorte."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Affiche un menu circulaire au curseur pour un magnétisme de fenêtre ultrarapide, le lancement d'apps et des actions rapides avec une physique de ressort."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Mostra un menu circolare sul cursore per aggancio finestre ultrarapido, avvio app e azioni rapide con fisica a molla."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "スプリング物理演算を備えた円形パイメニューをカーソル位置に呼び出し、超高速なスナップ、アプリ起動、クイックアクションを実現します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "스프링 물리 효과를 적용한 원형 파이 메뉴를 커서 위치에 표시하여 초고속 창 스냅, 앱 실행 및 빠른 동작을 지원합니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Roept een cirkelvormig taartmenu op bij uw cursor voor razendsnel vastklikken van vensters, apps openen en snelle acties met veerfysica."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Exibe um menu circular no cursor para encaixe ultrarrápido de janelas, abertura de apps e ações rápidas com física de mola."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Exibe um menu circular no cursor para ajuste ultrarrápido de janelas, abertura de aplicações e ações rápidas com física de mola."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Вызывает круговое меню у курсора для молниеносного прилипания окон, запуска приложений и быстрых действий с пружинной физикой."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在光标处呼出带有弹性物理动画的圆形扇区菜单，用于极速窗口吸附、启动应用和快捷操作。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在游標處呼叫帶有彈性物理動畫的圓形扇形選單，用於極速視窗貼齊、啟動應用和快捷操作。"
          }
        }
      }
    },
