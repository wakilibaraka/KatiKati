    "Capsule mode: collapse any box to a pill from its ellipsis menu; hover to peek, or dock it to a screen edge." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kapselmodus: Jede Box über das Ellipsenmenü zur Kapsel verkleinern; zum Ansehen darüberfahren oder am Bildschirmrand andocken."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Capsule mode: collapse any box to a pill from its ellipsis menu; hover to peek, or dock it to a screen edge."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Modo cápsula: contrae cualquier caja a una cápsula desde su menú de puntos suspensivos; pasa el cursor para ver o acóplala al borde de la pantalla."
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Modo cápsula: contrae cualquier caja a una cápsula desde su menú de puntos suspensivos; pasa el cursor para ver o acóplala al borde de la pantalla."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mode capsule : réduisez une boîte en capsule depuis son menu « … » ; survolez pour jeter un œil ou ancrez-la au bord de l’écran."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Modalità capsula: comprimi qualsiasi casella in capsula dal menu con i puntini; passa il cursore per sbirciare o agganciala al bordo dello schermo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "カプセルモード：「…」メニューからボックスをカプセルに縮小。ホバーで一時表示、画面端への固定も可能。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "캡슐 모드: 말줄임표 메뉴에서 박스를 캡슐로 접고, 마우스를 올려 미리 보거나 화면 가장자리에 고정하세요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Modo cápsula: recolha qualquer caixa em cápsula pelo menu de reticências; passe o mouse para espiar ou fixe na borda da tela."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Modo cápsula: recolha qualquer caixa em cápsula pelo menu de reticências; passe o mouse para espiar ou fixe na borda da tela."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "胶囊模式：从省略号菜单把任意盒子折叠成胶囊；悬停即可展开查看，也可停靠到屏幕边缘。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "膠囊模式：從省略號選單把任意盒子摺疊成膠囊；懸停即可展開查看，也可停靠到螢幕邊緣。"
          }
        }
      }
    },
