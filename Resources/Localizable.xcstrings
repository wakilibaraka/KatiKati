    "Holds water reminders while a focus session, a call, the camera or the microphone is in use." : {
      "localizations" : {
        "de" : { "stringUnit" : { "state" : "translated", "value" : "Hält Wasser-Erinnerungen zurück, solange eine Fokus-Sitzung, ein Anruf, die Kamera oder das Mikrofon läuft." } },
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Holds water reminders while a focus session, a call, the camera or the microphone is in use." } },
        "es" : { "stringUnit" : { "state" : "translated", "value" : "Retiene los recordatorios de agua mientras hay una sesión de concentración, una llamada, la cámara o el micrófono en uso." } },
        "es-419" : { "stringUnit" : { "state" : "translated", "value" : "Retiene los recordatorios de agua mientras hay una sesión de concentración, una llamada, la cámara o el micrófono en uso." } },
        "fr" : { "stringUnit" : { "state" : "translated", "value" : "Suspend les rappels d’eau pendant une session de concentration, un appel, ou quand la caméra ou le micro est utilisé." } },
        "it" : { "stringUnit" : { "state" : "translated", "value" : "Trattiene i promemoria dell’acqua durante una sessione di concentrazione, una chiamata o con videocamera o microfono in uso." } },
        "ja" : { "stringUnit" : { "state" : "translated", "value" : "集中セッション、通話、カメラやマイクの使用中は水分リマインダーを控えます。" } },
        "ko" : { "stringUnit" : { "state" : "translated", "value" : "집중 세션, 통화, 카메라나 마이크 사용 중에는 물 알림을 멈춥니다." } },
        "pt-BR" : { "stringUnit" : { "state" : "translated", "value" : "Segura os lembretes de água durante uma sessão de foco, uma chamada, ou com a câmera ou o microfone em uso." } },
        "pt-PT" : { "stringUnit" : { "state" : "translated", "value" : "Suspende os lembretes de água durante uma sessão de concentração, uma chamada, ou com a câmara ou o microfone em uso." } },
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "在专注时段、通话中，或摄像头、麦克风使用时暂缓喝水提醒。" } },
        "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "在專注時段、通話中，或相機、麥克風使用時暫緩喝水提醒。" } }
      }
    },
    "Hydrate" : {
      "localizations" : {
        "de" : { "stringUnit" : { "state" : "translated", "value" : "Trinken" } },
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Hydrate" } },
        "es" : { "stringUnit" : { "state" : "translated", "value" : "Hidratación" } },
        "es-419" : { "stringUnit" : { "state" : "translated", "value" : "Hidratación" } },
        "fr" : { "stringUnit" : { "state" : "translated", "value" : "Hydratation" } },
        "it" : { "stringUnit" : { "state" : "translated", "value" : "Idratazione" } },
        "ja" : { "stringUnit" : { "state" : "translated", "value" : "水分補給" } },
        "ko" : { "stringUnit" : { "state" : "translated", "value" : "수분 섭취" } },
        "pt-BR" : { "stringUnit" : { "state" : "translated", "value" : "Hidratação" } },
        "pt-PT" : { "stringUnit" : { "state" : "translated", "value" : "Hidratação" } },
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "补水" } },
        "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "補水" } }
      }
    },
    "Hydration cadence, goal and pause prompts live on the Notch page, under Daily Helpers." : {
      "localizations" : {
        "de" : { "stringUnit" : { "state" : "translated", "value" : "Trink-Intervall, Ziel und Pausen-Texte stehen auf der Notch-Seite unter Tägliche Helfer." } },
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Hydration cadence, goal and pause prompts live on the Notch page, under Daily Helpers." } },
        "es" : { "stringUnit" : { "state" : "translated", "value" : "La frecuencia, el objetivo y los textos de pausa de hidratación están en la página Notch, en Ayudantes diarios." } },
        "es-419" : { "stringUnit" : { "state" : "translated", "value" : "La frecuencia, el objetivo y los textos de pausa de hidratación están en la página Notch, en Ayudantes diarios." } },
        "fr" : { "stringUnit" : { "state" : "translated", "value" : "La fréquence, l’objectif et les textes de pause de l’hydratation se trouvent sur la page Notch, sous Aides quotidiennes." } },
        "it" : { "stringUnit" : { "state" : "translated", "value" : "Frequenza, obiettivo e testi di pausa dell’idratazione sono nella pagina Notch, sotto Aiuti quotidiani." } },
        "ja" : { "stringUnit" : { "state" : "translated", "value" : "水分補給の間隔・目標・休憩の文言は、ノッチページの「毎日のヘルパー」にあります。" } },
        "ko" : { "stringUnit" : { "state" : "translated", "value" : "수분 섭취 주기, 목표, 휴식 문구는 노치 페이지의 ‘일일 도우미’에 있습니다." } },
        "pt-BR" : { "stringUnit" : { "state" : "translated", "value" : "Frequência, meta e textos de pausa da hidratação ficam na página Notch, em Ajudantes diários." } },
        "pt-PT" : { "stringUnit" : { "state" : "translated", "value" : "Frequência, objetivo e textos de pausa da hidratação estão na página Notch, em Ajudantes diários." } },
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "喝水间隔、目标和休息文案在刘海页面的“每日助手”中。" } },
        "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "喝水間隔、目標和休息文案在瀏海頁面的「每日小工具」中。" } }
      }
    },
    "Notification Center's layout changes between macOS updates. When it looks unfamiliar, KatiKati leaves banners where they are, and the notch inbox still lists them." : {
      "localizations" : {
        "de" : { "stringUnit" : { "state" : "translated", "value" : "Das Layout der Mitteilungszentrale ändert sich zwischen macOS-Updates. Wirkt es unbekannt, lässt KatiKati Banner stehen – der Notch-Posteingang listet sie weiterhin." } },
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Notification Center's layout changes between macOS updates. When it looks unfamiliar, KatiKati leaves banners where they are, and the notch inbox still lists them." } },
        "es" : { "stringUnit" : { "state" : "translated", "value" : "El diseño del Centro de notificaciones cambia entre versiones de macOS. Cuando no lo reconoce, KatiKati deja los avisos donde están y la bandeja del notch sigue mostrándolos." } },
        "es-419" : { "stringUnit" : { "state" : "translated", "value" : "El diseño del Centro de notificaciones cambia entre versiones de macOS. Cuando no lo reconoce, KatiKati deja los avisos donde están y la bandeja del notch sigue mostrándolos." } },
        "fr" : { "stringUnit" : { "state" : "translated", "value" : "La disposition du Centre de notifications change d’une version de macOS à l’autre. Quand elle est inconnue, KatiKati laisse les bannières en place et la boîte du notch les liste toujours." } },
        "it" : { "stringUnit" : { "state" : "translated", "value" : "Il layout del Centro notifiche cambia tra un aggiornamento di macOS e l’altro. Quando non lo riconosce, KatiKati lascia i banner dov’è e la casella del notch li elenca comunque." } },
        "ja" : { "stringUnit" : { "state" : "translated", "value" : "通知センターのレイアウトはmacOSの更新で変わります。見慣れない形のときはバナーをそのままにし、ノッチの受信トレイには引き続き表示します。" } },
        "ko" : { "stringUnit" : { "state" : "translated", "value" : "알림 센터의 레이아웃은 macOS 업데이트마다 바뀝니다. 낯선 모양이면 배너를 그대로 두고, 노치 수신함에는 계속 표시합니다." } },
        "pt-BR" : { "stringUnit" : { "state" : "translated", "value" : "O layout da Central de Notificações muda entre versões do macOS. Quando não o reconhece, o KatiKati deixa os avisos onde estão e a caixa do notch continua listando-os." } },
        "pt-PT" : { "stringUnit" : { "state" : "translated", "value" : "O layout do Centro de Notificações muda entre versões do macOS. Quando não o reconhece, o KatiKati deixa os avisos onde estão e a caixa do notch continua a listá-los." } },
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "通知中心的布局会随 macOS 更新而改变。遇到不认识的布局时，KatiKati 会把横幅留在原处，刘海收件箱仍会列出它们。" } },
        "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "通知中心的佈局會隨 macOS 更新而改變。遇到不認識的佈局時，KatiKati 會把橫幅留在原處，瀏海收件匣仍會列出它們。" } }
      }
    },
    "Paused during focus" : {
      "localizations" : {
        "de" : { "stringUnit" : { "state" : "translated", "value" : "Im Fokus pausiert" } },
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Paused during focus" } },
