    "Accessibility permission is required to read menu bar shortcuts from other apps." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zum Lesen der Menüleisten-Kurzbefehle anderer Apps ist die Bedienungshilfen-Berechtigung nötig."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Accessibility permission is required to read menu bar shortcuts from other apps."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se necesita permiso de Accesibilidad para leer los atajos de la barra de menús de otras apps."
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se necesita permiso de Accesibilidad para leer los atajos de la barra de menús de otras apps."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L'autorisation Accessibilité est nécessaire pour lire les raccourcis de la barre des menus des autres apps."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Per leggere le scorciatoie della barra dei menu di altre app serve l'autorizzazione Accessibilità."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "他のアプリのメニューバーショートカットを読み取るには、アクセシビリティの許可が必要です。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "다른 앱의 메뉴 막대 단축키를 읽으려면 손쉬운 사용 권한이 필요합니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "É necessária a permissão de Acessibilidade para ler os atalhos da barra de menus de outros apps."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
