        "en": {"stringUnit": {"state": "translated", "value": "Undo every change made since Settings opened"}},
        "zh-Hans": {"stringUnit": {"state": "needs_review", "value": "撤销自打开设置以来的所有更改"}},
        "zh-Hant": {"stringUnit": {"state": "needs_review", "value": "復原自開啟設定以來的所有更改"}},
        "ja": {"stringUnit": {"state": "needs_review", "value": "設定を開いてからのすべての変更を取り消します"}},
        "de": {"stringUnit": {"state": "needs_review", "value": "Alle Änderungen seit dem Öffnen der Einstellungen rückgängig machen"}},
        "fr": {"stringUnit": {"state": "needs_review", "value": "Annule toutes les modifications faites depuis l’ouverture des réglages"}},
