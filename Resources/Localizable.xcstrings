        "ja" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "KatiKati が他のアプリのウインドウを動かすには、macOS でこの許可が必要です。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "KatiKati가 다른 앱의 윈도우를 옮기려면 macOS에서 이 권한이 필요합니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "macOS needs this before KatiKati can move other apps' windows."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "O macOS exige isto para que o KatiKati possa mover janelas de outros apps."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "O macOS exige isto para que o KatiKati possa mover janelas de outras apps."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "macOS needs this before KatiKati can move other apps' windows."
          }
