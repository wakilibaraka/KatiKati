    "Floating card stack, shake-to-shelf, Notch File Tray, and space pinning." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Schwebender Kartenstapel, Schüttel-Ablage, Notch-Dateifach und Space-Fixierung."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Floating card stack, shake-to-shelf, Notch File Tray, and space pinning."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pila flotante, agitar para guardar, bandeja del notch y orden de espacios."
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pila flotante, agitar para guardar, bandeja del notch y orden de espacios."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pile de cartes flottantes, secouer pour déposer, bac de l’encoche et espaces fixes."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pila fluttuante, scuoti per vassoio, Notch File Tray e ordine degli spazi."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "フローティングカードスタック、シェイクでシェルフ、ノッチトレイ、操作スペース固定。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "플로팅 카드 스택, 흔들어 선반 열기, 노치 파일 트레이 및 스페이스 고정."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pilha flutuante, agitar para guardar, bandeja do notch e ordem fixa dos espaços."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pilha flutuante, abanar para guardar, tabuleiro do entalhe e espaços fixos."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "悬浮卡片堆叠、晃动唤出暂存架、刘海文件托盘与固定桌面空间。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "懸浮卡片堆疊、晃動喚出暫存架、瀏海檔案托盤與固定桌面空間。"
          }
        }
      }
    },
    "Floating keeps the bar 8 pt above the screen edge. Hugging sits it almost on the edge." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Schwebend hält die Leiste 8 pt über dem Bildschirmrand. Anliegend setzt sie fast direkt auf den Rand."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Floating keeps the bar 8 pt above the screen edge. Hugging sits it almost on the edge."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Flotante deja la barra 8 pt por encima del borde. Pegada la coloca casi sobre el borde."
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Flotante deja la barra 8 pt por encima del borde. Pegada la coloca casi sobre el borde."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Flottante garde la barre à 8 pt du bord de l’écran. Collée la place presque sur le bord."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fluttuante tiene la barra 8 pt sopra il bordo. Aderente la posa quasi sul bordo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "フローティングは画面端から 8 pt 上に表示し、密着はほぼ端に配置します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "떠 있음은 막대를 화면 가장자리에서 8pt 위에 두고, 붙임은 거의 가장자리에 둡니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Flutuante mantém a barra 8 pt acima da borda. Encostada a deixa quase na borda."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Flutuante mantém a barra 8 pt acima da margem. Encostada coloca-a quase na margem."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "浮动：任务栏离屏幕底边 8 pt。贴边：几乎贴在底边上。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "浮動：工作列離螢幕底邊 8 pt。貼邊：幾乎貼在底邊上。"
          }
        }
      }
    },
    "Floats at native level when clear, drops below windows when overlapped, and peeks on edge hover." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Schwebt frei, weicht unter überlappende Fenster aus und erscheint beim Kanten-Hover."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Floats at native level when clear, drops below windows when overlapped, and peeks on edge hover."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Flota libremente, se coloca detrás al superponerse y asoma al posar el cursor en el borde."
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Flota libremente, se coloca detrás al superponerse y asoma al posar el cursor en el borde."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Reste au premier plan si libre, glisse sous les fenêtres couvertes et apparaît au survol du bord."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fluttua normalmente, scende sotto le finestre sovrapposte e compare sfiorando il bordo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "何もないときは前面、重なり時は背面に回り、画面下端ホバーで手前に浮上します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "창이 없을 땐 위에 뜨고, 겹치면 뒤로 내려가며 가장자리 호버 시 일시적으로 위로 올라옵니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Flutua livremente, fica sob janelas sobrepostas e surge ao passar o cursor pela borda."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Flutua livremente, fica sob janelas sobrepostas e surge ao passar o cursor pela borda."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "无重叠时常驻置顶，窗口覆盖时自动沉底，鼠标贴近底边时临时升起。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "無重疊時常駐置頂，視窗覆蓋時自動置底，滑鼠貼近底邊時臨時升起。"
          }
        }
      }
    },
